---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Kitsune Hideout — 개발 블로그' } = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} | Kitsune Hideout</title>
    <!-- theme init: runs before paint to prevent flash; light is default -->
    <script is:inline>
      if (localStorage.getItem('theme') !== 'dark') {
        document.documentElement.classList.add('light');
      }
    </script>
  </head>
  <body>
    <canvas id="bg-canvas"></canvas>
    <Sidebar />
    <main class="main-content">
      <slot />
      <Footer />
    </main>
  </body>
  <script is:inline>
    /* ── Full-viewport cosmic background canvas ── */
    (function () {
      var canvas = document.getElementById('bg-canvas');
      if (!canvas) return;
      var ctx = canvas.getContext('2d');
      var W = 0, H = 0;

      var TYPES = [
        { r:215, g:225, b:255 },
        { r:255, g:245, b:200 },
        { r:245, g:200, b:65  },
        { r:255, g:140, b:65  },
        { r:255, g:80,  b:70  },
        { r:185, g:150, b:255 },
      ];
      var WEIGHTS = [0.34, 0.20, 0.20, 0.12, 0.09, 0.05];

      function pickType() {
        var v = Math.random(), sum = 0;
        for (var k = 0; k < WEIGHTS.length; k++) {
          sum += WEIGHTS[k];
          if (v < sum) return k;
        }
        return 0;
      }

      var STAR_COUNT = 130;
      var stars = [];
      for (var i = 0; i < STAR_COUNT; i++) {
        stars.push({
          x:     Math.random(),
          y:     Math.random(),
          r:     Math.random() * 1.3 + 0.2,
          speed: 0.000012 + Math.random() * 0.000020,
          phase: Math.random() * 6.28,
          ti:    pickType(),
          base:  0.08 + Math.random() * 0.42,
          glow:  Math.random() < 0.22,
        });
      }

      var nebulae = [
        { nx:0.84, ny:0.22, nr:0.32, r:85,  g:115, b:255, sp:0.0000025, ph:0.8 },
        { nx:0.91, ny:0.60, nr:0.28, r:210, g:50,  b:85,  sp:0.0000018, ph:2.5 },
        { nx:0.80, ny:0.88, nr:0.26, r:200, g:165, b:50,  sp:0.0000014, ph:4.0 },
      ];

      function resize() {
        W = canvas.width  = window.innerWidth;
        H = canvas.height = window.innerHeight;
      }

      var prev = null;
      function frame(ts) {
        var dt = prev ? Math.min(ts - prev, 50) : 16;
        prev = ts;

        var cp   = ts * 0.000018;
        var rAdd = Math.max(0, Math.sin(cp))        * 16;
        var bAdd = Math.max(0, Math.sin(cp + 1.57)) * 10;
        var gAdd = Math.max(0, Math.sin(cp + 3.14)) * 6;
        var sg = ctx.createLinearGradient(0, 0, 0, H);
        sg.addColorStop(0,   'rgb('+Math.round(4+rAdd)+','+Math.round(4+gAdd)+','+Math.round(30+bAdd)+')');
        sg.addColorStop(0.5, 'rgb('+Math.round(6+rAdd)+','+Math.round(4+gAdd)+','+Math.round(22+bAdd)+')');
        sg.addColorStop(1,   'rgb('+Math.round(8+rAdd)+','+Math.round(5+gAdd)+','+Math.round(16+bAdd)+')');
        ctx.fillStyle = sg;
        ctx.fillRect(0, 0, W, H);

        for (var n = 0; n < nebulae.length; n++) {
          var nb = nebulae[n];
          nb.ny -= nb.sp * dt;
          if (nb.ny < -0.5) nb.ny = 1.5;
          var pulse = 0.55 + 0.45 * Math.sin(ts * 0.00025 + nb.ph);
          var ng = ctx.createRadialGradient(nb.nx*W, nb.ny*H, 0, nb.nx*W, nb.ny*H, nb.nr*W);
          ng.addColorStop(0,    'rgba('+nb.r+','+nb.g+','+nb.b+','+(0.055*pulse)+')');
          ng.addColorStop(0.45, 'rgba('+nb.r+','+nb.g+','+nb.b+','+(0.022*pulse)+')');
          ng.addColorStop(1,    'rgba('+nb.r+','+nb.g+','+nb.b+',0)');
          ctx.fillStyle = ng;
          ctx.beginPath();
          ctx.arc(nb.nx*W, nb.ny*H, nb.nr*W, 0, 6.28);
          ctx.fill();
        }

        for (var i = 0; i < stars.length; i++) {
          var s = stars[i];
          s.y -= s.speed * dt;
          if (s.y < 0) { s.y = 1; s.x = Math.random(); }
          var flicker = 0.55 + 0.45 * Math.sin(ts * 0.0011 + s.phase);
          var a = s.base * flicker;
          var col = TYPES[s.ti];
          var px = s.x * W, py = s.y * H;
          ctx.save();
          if (s.glow) {
            var grd = ctx.createRadialGradient(px, py, 0, px, py, s.r * 4);
            grd.addColorStop(0,   'rgba('+col.r+','+col.g+','+col.b+','+a+')');
            grd.addColorStop(0.4, 'rgba('+col.r+','+col.g+','+col.b+','+(a*0.20)+')');
            grd.addColorStop(1,   'rgba('+col.r+','+col.g+','+col.b+',0)');
            ctx.fillStyle = grd;
            ctx.beginPath(); ctx.arc(px, py, s.r * 4, 0, 6.28); ctx.fill();
          }
          ctx.fillStyle = 'rgba('+col.r+','+col.g+','+col.b+','+a+')';
          ctx.beginPath(); ctx.arc(px, py, s.r, 0, 6.28); ctx.fill();
          ctx.restore();
        }
        requestAnimationFrame(frame);
      }

      window.addEventListener('resize', resize);
      resize();
      requestAnimationFrame(frame);
    })();
  </script>
</html>
