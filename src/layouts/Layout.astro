---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  wideContent?: boolean;
}

const { title, description = 'Kitsune Hideout — 개발 블로그', wideContent = true } = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <slot name="head" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} | Kitsune Hideout</title>
    <!-- theme init: runs before paint to prevent flash; light is default -->
    <script is:inline>
      if (localStorage.getItem('theme') !== 'dark') {
        document.documentElement.classList.add('light');
      }
    </script>

    <!-- Loading overlay styles (inline so overlay appears before global.css) -->
    <style>
      #pg-load {
        position: fixed; inset: 0; z-index: 9999;
        display: flex; align-items: center; justify-content: center;
        background: rgba(2, 3, 18, 0.82);
        backdrop-filter: blur(7px);
        -webkit-backdrop-filter: blur(7px);
        transition: opacity 0.52s ease, visibility 0.52s ease;
      }
      #pg-load.done { opacity: 0; visibility: hidden; pointer-events: none; }

      /* Deep blue mist behind the hourglass */
      #pg-load-mist {
        position: absolute;
        width: 420px; height: 420px;
        border-radius: 50%;
        background: radial-gradient(ellipse at center,
          rgba(28, 55, 160, 0.58)  0%,
          rgba(22, 44, 130, 0.40) 22%,
          rgba(15, 30,  90, 0.22) 42%,
          rgba(10, 20,  62, 0.10) 58%,
          rgba( 6, 12,  40, 0.04) 72%,
          rgba( 3,  6,  22, 0.01) 84%,
          transparent             100%
        );
        animation: mistPulse 2.8s ease-in-out infinite;
        pointer-events: none;
      }
      @keyframes mistPulse {
        0%,100% { opacity: .82; transform: scale(1);    }
        50%      { opacity: 1;   transform: scale(1.08); }
      }

      .hg {
        position: relative; z-index: 1;
        animation: hgGlow 1.8s ease-in-out infinite;
      }
      @keyframes hgGlow {
        0%,100% {
          filter:
            drop-shadow(0 0 8px  rgba(201,162,39,.65))
            drop-shadow(0 0 22px rgba(201,162,39,.28));
        }
        50% {
          filter:
            drop-shadow(0 0 16px rgba(245,224,128,.95))
            drop-shadow(0 0 42px rgba(201,162,39,.55));
        }
      }
    </style>

    <!-- Hide loader on window.load (min 400ms so animation is visible) -->
    <script is:inline>
      (function () {
        var t0 = Date.now();
        function hideLoader() {
          var el = document.getElementById('pg-load');
          if (!el) return;
          var wait = Math.max(0, 400 - (Date.now() - t0));
          setTimeout(function () {
            el.classList.add('done');
            setTimeout(function () { el.remove(); }, 540);
          }, wait);
        }
        if (document.readyState === 'complete') hideLoader();
        else window.addEventListener('load', hideLoader);
      })();
    </script>
  </head>
  <body>
    <!-- Gold hourglass loading overlay -->
    <div id="pg-load" role="status" aria-label="페이지 로딩 중">
      <div id="pg-load-mist" aria-hidden="true"></div>
      <svg class="hg" width="60" height="90" viewBox="0 0 60 90"
           xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <defs>
          <linearGradient id="hg-g" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%"   stop-color="#f5e080"/>
            <stop offset="100%" stop-color="#c9a227"/>
          </linearGradient>
          <!-- top triangle clip -->
          <clipPath id="hg-tc"><polygon points="5,9 55,9 30,44"/></clipPath>
          <!-- bottom triangle clip -->
          <clipPath id="hg-bc"><polygon points="30,46 55,81 5,81"/></clipPath>
        </defs>

        <!-- Top cap -->
        <rect x="3" y="2" width="54" height="8" rx="4" fill="url(#hg-g)"/>
        <!-- Bottom cap -->
        <rect x="3" y="80" width="54" height="8" rx="4" fill="url(#hg-g)"/>

        <!-- Hourglass frame (two triangles meeting at waist) -->
        <path d="M5,10 L55,10 L30,44 L55,82 L5,82 L30,44 Z"
              fill="none" stroke="url(#hg-g)" stroke-width="2.2"
              stroke-linejoin="round"/>

        <!-- Top sand draining (height 35→1 over 2.6s) -->
        <rect x="0" y="9" width="60" height="35"
              fill="url(#hg-g)" opacity="0.42" clip-path="url(#hg-tc)">
          <animate attributeName="height" from="35" to="1"
                   dur="2.6s" repeatCount="indefinite"/>
        </rect>

        <!-- Bottom sand filling (y 79→46, height 3→36 over 2.6s) -->
        <rect x="0" y="79" width="60" height="3"
              fill="url(#hg-g)" opacity="0.58" clip-path="url(#hg-bc)">
          <animate attributeName="y"      from="79" to="46"  dur="2.6s" repeatCount="indefinite"/>
          <animate attributeName="height" from="3"  to="36" dur="2.6s" repeatCount="indefinite"/>
        </rect>

        <!-- Falling sand particles (3 staggered) -->
        <circle cx="30" r="2.2" fill="#f5e080">
          <animate attributeName="cy"      from="45" to="79"    dur="0.75s" repeatCount="indefinite" begin="0s"/>
          <animate attributeName="opacity" values="0;1;1;0"     dur="0.75s" repeatCount="indefinite" begin="0s"/>
        </circle>
        <circle cx="30" r="1.8" fill="#f0d060">
          <animate attributeName="cy"      from="45" to="79"    dur="0.75s" repeatCount="indefinite" begin="0.25s"/>
          <animate attributeName="opacity" values="0;1;1;0"     dur="0.75s" repeatCount="indefinite" begin="0.25s"/>
        </circle>
        <circle cx="30" r="1.8" fill="#f0d060">
          <animate attributeName="cy"      from="45" to="79"    dur="0.75s" repeatCount="indefinite" begin="0.50s"/>
          <animate attributeName="opacity" values="0;1;1;0"     dur="0.75s" repeatCount="indefinite" begin="0.50s"/>
        </circle>
      </svg>
    </div>

    <canvas id="bg-canvas"></canvas>
    <Sidebar />
    <main class:list={["main-content", { "main-wide": wideContent }]}>
      <slot />
      <Footer />
    </main>
  </body>
  <script is:inline>
    /* ── Full-viewport cosmic background canvas ── */
    (function () {
      var canvas = document.getElementById('bg-canvas');
      if (!canvas) return;
      var ctx = canvas.getContext('2d');
      var W = 0, H = 0;

      var SKY_DRIFT = 0.0000078; // normalized/ms, leftward drift

      var TYPES = [
        { r:215, g:225, b:255 }, { r:255, g:245, b:200 },
        { r:245, g:200, b:65  }, { r:255, g:140, b:65  },
        { r:255, g:80,  b:70  }, { r:185, g:150, b:255 },
        { r:75,  g:205, b:235 }, { r:255, g:110, b:185 },
      ];
      var WEIGHTS = [0.26, 0.16, 0.16, 0.10, 0.08, 0.10, 0.08, 0.06];
      function pickType() {
        var v = Math.random(), sum = 0;
        for (var k = 0; k < WEIGHTS.length; k++) { sum += WEIGHTS[k]; if (v < sum) return k; }
        return 0;
      }

      var stars = [];
      for (var i = 0; i < 155; i++) {
        stars.push({ x: Math.random(), y: Math.random(),
          r: Math.random() * 1.4 + 0.2,
          speed: SKY_DRIFT * (0.7 + Math.random() * 0.6),
          fspd: 0.3 + Math.random() * 0.8,
          phase: Math.random() * 6.28,
          ti: pickType(), base: 0.10 + Math.random() * 0.48,
          glow: Math.random() < 0.35 });
      }

      /* Moon */
      var moon = { rx: 0.78, ry: 0.14 };
      var MOON_R = 22;

      /* Nebulae: drift left (nx) */
      var nebulae = [
        { nx:0.82, ny:0.15, nr:0.42, r:115, g:70,  b:235, sp:0.0000022, ph:0.8 },
        { nx:0.94, ny:0.42, nr:0.36, r:225, g:55,  b:130, sp:0.0000016, ph:2.5 },
        { nx:0.76, ny:0.70, nr:0.40, r:45,  g:175, b:220, sp:0.0000013, ph:4.0 },
        { nx:0.97, ny:0.25, nr:0.26, r:215, g:160, b:50,  sp:0.0000028, ph:1.2 },
        { nx:0.68, ny:0.88, nr:0.34, r:65,  g:105, b:250, sp:0.0000018, ph:3.5 },
        { nx:0.90, ny:0.60, nr:0.30, r:45,  g:185, b:145, sp:0.0000020, ph:5.2 },
      ];

      /* Clouds */
      var clouds = [];
      for (var c = 0; c < 12; c++) {
        clouds.push({ x: Math.random() * 1.5, y: 0.02 + Math.random() * 0.40,
          w: 0.22 + Math.random() * 0.30, alpha: 0.10 + Math.random() * 0.13,
          speed: SKY_DRIFT * (0.58 + Math.random() * 0.55),
          phase: Math.random() * 6.28 });
      }

      /* Weather: none → rain/snow → none cycle */
      var WX = { state:'none', intensity:0, target:0, nextChange:42000 };
      var rain = [];
      for (var i = 0; i < 220; i++)
        rain.push({ x:Math.random(), y:Math.random(),
          spd:0.00038+Math.random()*0.00020, len:9+Math.random()*11 });
      var snow = [];
      for (var i = 0; i < 90; i++)
        snow.push({ x:Math.random(), y:Math.random(),
          r:1.0+Math.random()*2.2, spd:0.000048+Math.random()*0.000062,
          phase:Math.random()*6.28, dAmp:0.00010+Math.random()*0.00013,
          alpha:0.28+Math.random()*0.28 });

      /* Wave layers — Stokes 2nd-order + chop (background→foreground) */
      var WAVES = [
        { speed:0.000062, amp:5,  freq:0.018,  yBase:0.800, alpha:0.18, steep:0.28, p2:1.15, p3:2.40 },
        { speed:0.000094, amp:9,  freq:0.013,  yBase:0.822, alpha:0.22, steep:0.34, p2:2.55, p3:0.65 },
        { speed:0.000138, amp:13, freq:0.009,  yBase:0.842, alpha:0.26, steep:0.39, p2:0.38, p3:3.05 },
        { speed:0.000190, amp:17, freq:0.0064, yBase:0.860, alpha:0.27, steep:0.43, p2:1.88, p3:1.28 },
        { speed:0.000258, amp:21, freq:0.0044, yBase:0.876, alpha:0.19, steep:0.46, p2:3.22, p3:0.48 },
      ];
      /* Foam spray — ride front-layer crests */
      var foam = [];
      for (var i = 0; i < 90; i++)
        foam.push({ nx:Math.random(), li:2+(i%3), phase:Math.random()*6.28,
          alpha:0.18+Math.random()*0.45, r:0.5+Math.random()*1.8 });

      function resize() { W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; }

      /* shared sky color — updated each frame by drawSky, read by drawFog + drawSea */
      var skyR=5, skyG=5, skyB=22;

      function drawSky(ts) {
        // 주기 0.000042 ≈ 2.5분 (이전 8분에서 3.2× 가속)
        var t=ts*0.000042, c1=Math.max(0,Math.sin(t)), c2=Math.max(0,Math.sin(t*0.68+2.0)), c3=Math.max(0,Math.sin(t*0.45+4.1));
        // 붉은색: c1 피크 시 br≈95, bg≈11 — 명확한 크림슨. 파란색 진폭은 유지.
        var br=Math.round(5+c1*90+c3*12), bg=Math.round(5+c2*18+c1*6), bb=Math.round(22+c2*24+c3*16);
        skyR=br; skyG=bg; skyB=bb;  // expose to other draw functions
        var sg=ctx.createLinearGradient(0,0,0,H);
        sg.addColorStop(0,   'rgb('+(br+10)+','+(bg+4)+','+(bb+12)+')');
        sg.addColorStop(0.45,'rgb('+br+','+bg+','+bb+')');
        sg.addColorStop(1,   'rgb('+Math.max(br-2,2)+','+Math.max(bg-1,2)+','+Math.max(bb-3,16)+')');
        ctx.fillStyle=sg; ctx.fillRect(0,0,W,H);
      }

      function drawNebulae(ts) {
        for (var n=0; n<nebulae.length; n++) {
          var nb=nebulae[n], pulse=0.46+0.54*Math.sin(ts*0.00022+nb.ph);
          var ng=ctx.createRadialGradient(nb.nx*W,nb.ny*H,0,nb.nx*W,nb.ny*H,nb.nr*W);
          ng.addColorStop(0,   'rgba('+nb.r+','+nb.g+','+nb.b+','+(0.082*pulse)+')');
          ng.addColorStop(0.42,'rgba('+nb.r+','+nb.g+','+nb.b+','+(0.034*pulse)+')');
          ng.addColorStop(1,   'rgba('+nb.r+','+nb.g+','+nb.b+',0)');
          ctx.fillStyle=ng; ctx.beginPath(); ctx.arc(nb.nx*W,nb.ny*H,nb.nr*W,0,6.28); ctx.fill();
        }
      }

      function drawMoon() {
        var mx=moon.rx*W, my=moon.ry*H, r=MOON_R;
        var halo=ctx.createRadialGradient(mx,my,r*0.4,mx,my,r*2.8);
        halo.addColorStop(0,  'rgba(190,182,160,0.07)');
        halo.addColorStop(0.5,'rgba(150,143,125,0.03)');
        halo.addColorStop(1,  'rgba(100,95,80,0)');
        ctx.fillStyle=halo; ctx.beginPath(); ctx.arc(mx,my,r*2.8,0,6.28); ctx.fill();
        var mg=ctx.createRadialGradient(mx-r*0.28,my-r*0.28,r*0.04,mx,my,r);
        mg.addColorStop(0,    'rgba(215,208,188,0.32)');
        mg.addColorStop(0.55, 'rgba(172,165,147,0.22)');
        mg.addColorStop(1,    'rgba(120,115,100,0.09)');
        ctx.fillStyle=mg;
        ctx.beginPath(); ctx.arc(mx,my,r,0,6.28,false); ctx.arc(mx+r*0.54,my,r*0.87,0,6.28,false);
        ctx.fill('evenodd');
      }

      function drawStars(ts) {
        for (var i=0; i<stars.length; i++) {
          var s=stars[i], flicker=0.52+0.48*Math.sin(ts*0.0011*s.fspd+s.phase), a=s.base*flicker;
          var col=TYPES[s.ti], px=s.x*W, py=s.y*H;
          ctx.save();
          if (s.glow) {
            var grd=ctx.createRadialGradient(px,py,0,px,py,s.r*5);
            grd.addColorStop(0,   'rgba('+col.r+','+col.g+','+col.b+','+a+')');
            grd.addColorStop(0.38,'rgba('+col.r+','+col.g+','+col.b+','+(a*0.25)+')');
            grd.addColorStop(1,   'rgba('+col.r+','+col.g+','+col.b+',0)');
            ctx.fillStyle=grd; ctx.beginPath(); ctx.arc(px,py,s.r*5,0,6.28); ctx.fill();
          }
          ctx.fillStyle='rgba('+col.r+','+col.g+','+col.b+','+a+')';
          ctx.beginPath(); ctx.arc(px,py,s.r,0,6.28); ctx.fill(); ctx.restore();
        }
      }

      function drawClouds(ts) {
        var PUFFS=[
          {dx: 0,    dy: 0,    rs:.30},
          {dx:-.32,  dy: .10,  rs:.23},{dx: .32,  dy: .08,  rs:.22},
          {dx:-.62,  dy: .19,  rs:.17},{dx: .60,  dy: .17,  rs:.16},
          {dx:-.88,  dy: .26,  rs:.12},{dx: .86,  dy: .24,  rs:.11},
          {dx:-.16,  dy:-.11,  rs:.17},{dx: .17,  dy:-.10,  rs:.16},
        ];
        for (var c=0; c<clouds.length; c++) {
          var cl=clouds[c], cx=cl.x*W, cw=cl.w*W;
          var cy=cl.y*H+Math.sin(ts*0.00018+cl.phase)*2.5;
          for (var p=0; p<PUFFS.length; p++) {
            var pf=PUFFS[p], pfx=cx+pf.dx*cw, pfy=cy+pf.dy*cw, pr=pf.rs*cw;
            var g=ctx.createRadialGradient(pfx,pfy,0,pfx,pfy,pr);
            g.addColorStop(0,   'rgba(95,110,175,'+cl.alpha+')');
            g.addColorStop(0.40,'rgba(72,90,158,'+(cl.alpha*0.55)+')');
            g.addColorStop(1,   'rgba(50,68,140,0)');
            ctx.fillStyle=g; ctx.beginPath(); ctx.arc(pfx,pfy,pr,0,6.28); ctx.fill();
          }
        }
      }

      function updateWX(dt, elp) {
        var step=dt*0.00055;
        if (WX.intensity<WX.target) WX.intensity=Math.min(WX.target,WX.intensity+step);
        else if (WX.intensity>WX.target) WX.intensity=Math.max(WX.target,WX.intensity-step);
        if (elp<WX.nextChange) return;
        if (WX.state==='none') {
          WX.state=Math.random()<0.52?'rain':'snow'; WX.target=1;
          WX.nextChange=elp+26000+Math.random()*30000;
        } else { WX.target=0; WX.state='none'; WX.nextChange=elp+58000+Math.random()*68000; }
      }

      function drawRain(dt) {
        if (WX.state!=='rain'||WX.intensity<=0) return;
        var ax=0.17; ctx.save(); ctx.globalAlpha=0.20*WX.intensity;
        ctx.strokeStyle='rgba(200,220,248,1)'; ctx.lineWidth=1.0; ctx.beginPath();
        for (var i=0; i<rain.length; i++) {
          var d=rain[i]; d.y+=d.spd*dt; d.x+=d.spd*dt*ax;
          if (d.y>1.05){d.y=-0.06;d.x=Math.random();} if(d.x>1.05)d.x-=1.05;
          ctx.moveTo(d.x*W-d.len*ax,d.y*H-d.len); ctx.lineTo(d.x*W,d.y*H);
        }
        ctx.stroke(); ctx.restore();
      }

      function drawSnow(dt, elp) {
        if (WX.state!=='snow'||WX.intensity<=0) return;
        ctx.save(); ctx.fillStyle='rgba(218,232,255,1)';
        for (var i=0; i<snow.length; i++) {
          var s=snow[i]; s.y+=s.spd*dt; s.x+=Math.sin(elp*0.00072+s.phase)*s.dAmp*dt;
          if(s.y>1.04){s.y=-0.04;s.x=Math.random();}
          if(s.x<-0.02)s.x+=1.04; if(s.x>1.02)s.x-=1.04;
          ctx.globalAlpha=s.alpha*WX.intensity; ctx.beginPath(); ctx.arc(s.x*W,s.y*H,s.r,0,6.28); ctx.fill();
        }
        ctx.restore();
      }

      function drawFog(ts) {
        var fogY=H*0.74, pulse=0.18+0.05*Math.sin(ts*0.00040);
        var fg=ctx.createLinearGradient(0,fogY-50,0,fogY+70);
        var fR=Math.max(Math.round(skyR*0.28),2), fG=Math.max(Math.round(skyG*0.22),2), fB=Math.max(Math.round(skyB*0.5+4),12);
        fg.addColorStop(0,'rgba(0,0,0,0)'); fg.addColorStop(0.38,'rgba('+fR+','+fG+','+fB+','+pulse+')'); fg.addColorStop(1,'rgba(0,0,0,0)');
        ctx.fillStyle=fg; ctx.fillRect(0,fogY-50,W,120);
      }

      function waveY(layer, x, elp) {
        var t=elp*layer.speed, A=layer.amp, k=layer.freq;
        var s1=Math.sin(x*k-t*2.2);
        var h1=A*(s1-layer.steep*s1*s1);                    // Stokes 비대칭 (날카로운 마루)
        var h2=A*0.27*Math.sin(x*k*1.74+t*1.8+layer.p2);   // 역방향 간섭파
        var h3=A*0.14*Math.sin(x*k*0.40-t*1.1+layer.p3);   // 장파 너울
        var h4=A*0.20*Math.sin(x*k*3.8-t*4.5+layer.p2*0.7);// 고주파 잔물결
        var h5=A*0.11*Math.sin(x*k*6.2+t*6.8+layer.p3*1.3);// 초고주파 파쇄 잡음
        return layer.yBase*H + h1+h2+h3+h4+h5;
      }

      function drawSea(elp, dt) {
        /* Sea base — transparent top matches sky, darkens toward bottom */
        var seaGrad=ctx.createLinearGradient(0,H*0.78,0,H);
        seaGrad.addColorStop(0,    'rgba('+skyR+','+skyG+','+skyB+',0)');
        seaGrad.addColorStop(0.06, 'rgba('+Math.max(skyR-2,2)+','+Math.max(skyG-2,2)+','+Math.max(skyB-3,12)+',0.97)');
        seaGrad.addColorStop(1,    'rgba('+Math.max(Math.round(skyR*0.48),12)+','+Math.max(Math.round(skyG*0.24),4)+','+Math.max(Math.round(skyB*0.44+6),14)+',1)');
        ctx.fillStyle=seaGrad; ctx.fillRect(0,H*0.78,W,H);

        /* wave tint derived from sky */
        var wR=Math.max(Math.round(skyR*0.22+3),3), wG=Math.max(Math.round(skyG*0.18+2),2), wB=Math.max(Math.round(skyB*0.42+10),14);
        /* crest color: bright but sky-tinted */
        var cR=Math.min(255,Math.round(120+skyR*1.3)), cG=Math.min(255,Math.round(135+skyG*1.1)), cB=Math.min(255,Math.round(160+skyB*0.8));

        for (var li=0; li<WAVES.length; li++) {
          var layer=WAVES[li], step=3;
          /* Wave body fill */
          ctx.beginPath();
          for (var x=0; x<=W; x+=step) { var y=waveY(layer,x,elp); x===0?ctx.moveTo(x,y):ctx.lineTo(x,y); }
          ctx.lineTo(W,H); ctx.lineTo(0,H); ctx.closePath();
          var wg=ctx.createLinearGradient(0,layer.yBase*H-layer.amp,0,H);
          wg.addColorStop(0,  'rgba('+wR+','+wG+','+wB+','+(layer.alpha*0.55)+')');
          wg.addColorStop(0.3,'rgba('+Math.max(wR-4,1)+','+Math.max(wG-2,1)+','+Math.max(wB-6,10)+','+layer.alpha+')');
          wg.addColorStop(1,  'rgba('+Math.max(Math.round(skyR*0.32),6)+','+Math.max(Math.round(skyG*0.14),2)+','+Math.max(Math.round(skyB*0.36+4),10)+',0)');
          ctx.fillStyle=wg; ctx.fill();

          /* Crest: thick diffuse + thin bright ridge */
          ctx.beginPath();
          for (var x=0; x<=W; x+=step) { var y=waveY(layer,x,elp); x===0?ctx.moveTo(x,y):ctx.lineTo(x,y); }
          var wt=li/(WAVES.length-1);
          var cA=layer.alpha*(0.75+0.25*Math.sin(elp*0.00082+li*1.6));
          ctx.strokeStyle='rgba('+cR+','+cG+','+cB+','+(cA*0.40)+')'; ctx.lineWidth=2.0+wt*3.8; ctx.stroke();
          ctx.strokeStyle='rgba('+Math.min(255,cR+30)+','+Math.min(255,cG+20)+','+Math.min(255,cB+15)+','+cA+')'; ctx.lineWidth=0.65+wt*1.1; ctx.stroke();
        }

        /* Foam spray particles */
        ctx.save(); ctx.fillStyle='rgba('+Math.min(255,cR+35)+','+Math.min(255,cG+25)+','+Math.min(255,cB+10)+',1)';
        for (var i=0; i<foam.length; i++) {
          var f=foam[i], wl=WAVES[f.li];
          var pv=wl.speed*2.2/(wl.freq*W); // phase velocity (normalized/ms)
          f.nx+=pv*dt; if(f.nx>1.02) f.nx-=1.04;
          var fx=f.nx*W, wy=waveY(wl,fx,elp);
          var crestH=wl.yBase*H-wy; // positive near crest
          if (crestH<wl.amp*0.38) continue;
          var sprayOff=Math.abs(Math.sin(elp*0.0018+f.phase))*4;
          var pulse=0.40+0.60*Math.abs(Math.sin(elp*0.0022+f.phase));
          ctx.globalAlpha=f.alpha*pulse*Math.min(1,crestH/(wl.amp*0.8));
          ctx.beginPath(); ctx.arc(fx, wy-sprayOff, f.r, 0, 6.28); ctx.fill();
        }
        ctx.globalAlpha=1; ctx.restore();
      }

      var prev=null, elapsed=0;
      function frame(ts) {
        var dt=prev?Math.min(ts-prev,50):16; prev=ts; elapsed+=dt;

        /* Drift everything left */
        for (var i=0; i<stars.length; i++) {
          stars[i].x-=stars[i].speed*dt;
          if(stars[i].x<-0.02){stars[i].x=1.02;stars[i].y=Math.random();}
        }
        moon.rx-=SKY_DRIFT*dt; if(moon.rx<-0.15)moon.rx=1.15;
        for (var n=0; n<nebulae.length; n++) {
          nebulae[n].nx-=nebulae[n].sp*dt;
          if(nebulae[n].nx<-(nebulae[n].nr*0.6))nebulae[n].nx=1+nebulae[n].nr*0.6;
        }
        for (var c=0; c<clouds.length; c++) {
          clouds[c].x-=clouds[c].speed*dt; if(clouds[c].x<-0.30)clouds[c].x+=1.60;
        }

        updateWX(dt, elapsed);
        ctx.clearRect(0,0,W,H);
        drawSky(ts); drawNebulae(ts); drawMoon(); drawStars(ts);
        drawClouds(ts); drawFog(ts); drawSea(elapsed,dt); drawRain(dt); drawSnow(dt,elapsed);
        requestAnimationFrame(frame);
      }

      window.addEventListener('resize', resize);
      resize();
      requestAnimationFrame(frame);
    })();
  </script>
</html>
