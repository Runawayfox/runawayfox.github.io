---
import Layout from './Layout.astro';
import TagPill from '../components/TagPill.astro';
import QuoteCard from '../components/QuoteCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, pubDate, updatedDate, description, tags, image } = post.data;
const formattedDate = pubDate.toLocaleDateString('ko-KR', {
  year: 'numeric', month: 'long', day: 'numeric',
});
const updatedFormatted = updatedDate?.toLocaleDateString('ko-KR', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<Layout title={title} description={description}>

  <!-- ── 제목 영역: 항상 어두운 배경 + 흰색 텍스트 ──────── -->
  <div class="post-hero">
    {image && (
      <div
        class="post-hero-bg"
        style={`background-image: url('${image}');`}
        aria-hidden="true"
      ></div>
    )}
    <a href="/blog" class="back-link">← Blog</a>
    {tags.length > 0 && (
      <div class="post-hero-tags">
        {tags.map(tag => <TagPill tag={tag} />)}
      </div>
    )}
    <h1 class="post-article-title">{title}</h1>
    <div class="post-article-meta">
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      {updatedDate && <span>수정: {updatedFormatted}</span>}
    </div>
  </div>

  <!-- ── 바이탈 사인 경계선 ────────────────────────────────
       채운 영역(본문 배경색)이 바이탈 사인 선 아래를 덮어,
       히어로 사진이 바이탈 사인 모양대로 잘려 보이는 효과 생성
  ──────────────────────────────────────────────────────── -->
  <svg
    class="post-wave"
    viewBox="0 0 1200 120"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <!-- 본문 배경으로 채운 영역: 바이탈 사인 선 아래 전부 -->
    <path
      class="wave-fill"
      d="M0,68 L510,68 C518,68 524,54 530,54 C536,54 542,68 552,68 L563,76 L600,8 L637,80 L648,80 C654,80 660,52 668,52 C676,52 684,68 698,68 L1200,68 L1200,120 L0,120 Z"
    />
    <!-- 금색 바이탈 사인 윤곽선 -->
    <path
      class="wave-stroke"
      d="M0,68 L510,68 C518,68 524,54 530,54 C536,54 542,68 552,68 L563,76 L600,8 L637,80 L648,80 C654,80 660,52 668,52 C676,52 684,68 698,68 L1200,68"
    />
  </svg>

  <!-- ── 본문 영역 ──────────────────────────────────────── -->
  <div class="post-body">
    <QuoteCard />
    <article>
      <div class="prose prose-sm max-w-none">
        <slot />
      </div>
    </article>
  </div>

  <!-- ── 하단 네비 ─────────────────────────────────────── -->
  <div class="post-nav">
    <a href="/blog" class="back-link" style="margin-bottom:0">← 모든 글 보기</a>
  </div>

</Layout>

<style>
  /* ── 제목 영역 ──────────────────────────────────── */
  .post-hero {
    /* 다크/라이트 무관하게 항상 어두운 배경 */
    background: #060822;

    /* 자식 요소 텍스트를 항상 흰색 계열로 강제 */
    --text-primary:   #ffffff;
    --text-secondary: rgba(255, 255, 255, 0.75);
    --text-muted:     rgba(255, 255, 255, 0.50);
    /* 태그 필 테두리도 어두운 배경에 맞게 */
    --border:         rgba(255, 255, 255, 0.22);

    position: relative;
    margin: -60px -80px 0;
    /* padding-bottom: 120px — SVG가 이 영역을 덮음 */
    padding: 60px 80px 120px;
  }

  /* 배경 이미지: 80% 투명도 (opacity 0.2) */
  .post-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0.2;
    pointer-events: none;
  }

  .post-hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  /* ── 바이탈 사인 SVG ─────────────────────────────
     margin-top: -120px 으로 히어로의 padding-bottom 영역을 덮어,
     사진이 바이탈 사인 모양의 경계선에서 잘린 것처럼 보임
  ─────────────────────────────────────────────── */
  .post-wave {
    display: block;
    width: calc(100% + 160px);
    height: 120px;
    margin: -120px -80px 0;
    position: relative;
    z-index: 1;
  }

  /* 본문 배경색(--bg)으로 채워 히어로를 덮음 */
  .wave-fill { fill: var(--bg); }

  .wave-stroke {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.8;
    stroke-opacity: 0.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ── 본문 ───────────────────────────────────────── */
  .post-body {
    padding-top: 40px;
  }

  /* ── 하단 네비 ──────────────────────────────────── */
  .post-nav {
    margin-top: 60px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  /* ── 모바일 ─────────────────────────────────────── */
  @media (max-width: 1024px) {
    .post-hero {
      margin: -28px -16px 0;
      padding: 28px 16px 120px;
    }
    .post-wave {
      width: calc(100% + 32px);
      margin: -120px -16px 0;
    }
  }
</style>
