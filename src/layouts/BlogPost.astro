---
import Layout from './Layout.astro';
import TagPill from '../components/TagPill.astro';
import QuoteCard from '../components/QuoteCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, pubDate, updatedDate, description, tags, image } = post.data;
const formattedDate = pubDate.toLocaleDateString('ko-KR', {
  year: 'numeric', month: 'long', day: 'numeric',
});
const updatedFormatted = updatedDate?.toLocaleDateString('ko-KR', {
  year: 'numeric', month: 'long', day: 'numeric',
});

/*
 * 완만한 S자 곡선 경계선
 * ViewBox 0 0 1200 80  /  기준선 y=50
 * 전반 (0→600): 아래로 볼록 (트로프 y≈67)
 * 후반 (600→1200): 위로 볼록 (피크 y≈33)
 */
const WAVE_STROKE = 'M0,50 C100,72 500,72 600,50 C700,28 1100,28 1200,50';
const WAVE_FILL   = WAVE_STROKE + ' L1200,80 L0,80 Z';
---

<Layout title={title} description={description}>

  <!-- ── 제목 영역 ──────────────────────────────────────── -->
  <div class="post-hero">
    {image && (
      <div
        class="post-hero-bg"
        style={`background-image: url('${image}');`}
        aria-hidden="true"
      ></div>
    )}
    <a href="/blog" class="back-link">← Blog</a>
    {tags.length > 0 && (
      <div class="post-hero-tags">
        {tags.map(tag => <TagPill tag={tag} />)}
      </div>
    )}
    <h1 class="post-article-title">{title}</h1>
    <div class="post-article-meta">
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      {updatedDate && <span>수정: {updatedFormatted}</span>}
    </div>
  </div>

  <!-- ── 물결치는 파도 경계선 + 느린 금색 Shimmer ───────────
       JS가 매 프레임 d 속성을 갱신 → 실제로 파도처럼 움직임
       3개의 사인파 중첩으로 유기적인 바다 느낌 표현
       shimmer 그라디언트는 SVG SMIL로 독립적으로 스윕
  ──────────────────────────────────────────────────────── -->
  <svg
    class="post-wave"
    viewBox="0 0 1200 80"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <defs>
      <!-- 글로우 블러 필터 -->
      <filter id="wv-glow" x="-6%" y="-150%" width="112%" height="400%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="3.5" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>

      <!--
        Shimmer 그라디언트 (8초 느린 스윕)
        — 파도 경로가 움직여도 그라디언트는 독립적으로 흐름
      -->
      <linearGradient
        id="wv-shimmer"
        gradientUnits="userSpaceOnUse"
        x1="-200" y1="0"
        x2="200"  y2="0"
      >
        <stop offset="0%"   stop-color="#c9a227" stop-opacity="0.35"/>
        <stop offset="35%"  stop-color="#ddb830" stop-opacity="0.55"/>
        <stop offset="50%"  stop-color="#fff8c0" stop-opacity="1.00"/>
        <stop offset="65%"  stop-color="#ddb830" stop-opacity="0.55"/>
        <stop offset="100%" stop-color="#c9a227" stop-opacity="0.35"/>
        <animateTransform
          attributeName="gradientTransform"
          type="translate"
          from="-600 0"
          to="2000 0"
          dur="8s"
          repeatCount="indefinite"
        />
      </linearGradient>
    </defs>

    <!-- 본문 배경으로 채운 영역 (JS가 매 프레임 갱신) -->
    <path id="wv-fill-path"    class="wv-fill"    d={WAVE_FILL}/>

    <!-- 두꺼운 ambient 글로우 -->
    <path id="wv-ambient-path" class="wv-ambient" d={WAVE_STROKE} filter="url(#wv-glow)"/>

    <!-- 주 곡선 + Shimmer -->
    <path
      id="wv-stroke-path"
      class="wv-stroke"
      d={WAVE_STROKE}
      stroke="url(#wv-shimmer)"
      filter="url(#wv-glow)"
    />
  </svg>

  <!-- ── 본문 ──────────────────────────────────────────── -->
  <div class="post-body">
    <QuoteCard />
    <article>
      <div class="prose prose-sm max-w-none">
        <slot />
      </div>
    </article>
  </div>

  <!-- ── 하단 네비 ─────────────────────────────────────── -->
  <div class="post-nav">
    <a href="/blog" class="back-link" style="margin-bottom:0">← 모든 글 보기</a>
  </div>

  <!-- ── 플로팅 바 ──────────────────────────────────────── -->
  <div class="post-float-bar" id="post-float-bar" aria-hidden="true">
    <a href="/" class="pfb-logo" aria-label="홈으로">
      <div class="pfb-fox"></div>
    </a>
    <span class="pfb-title">{title}</span>
    <div class="pfb-actions">
      <button class="pfb-btn" id="pfb-up" aria-label="맨 위로 스크롤">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5" />
        </svg>
      </button>
      <button class="pfb-btn" id="pfb-down" aria-label="맨 아래로 스크롤">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
        </svg>
      </button>
    </div>
  </div>

</Layout>

<style>
  /* ── 제목 영역 ──────────────────────────────────── */
  .post-hero {
    background:
      radial-gradient(ellipse at 28% 65%, rgba(90,60,200,0.18) 0%, transparent 55%),
      radial-gradient(ellipse at 78% 28%, rgba(201,162,39,0.10) 0%, transparent 48%),
      #060822;
    --text-primary:   #ffffff;
    --text-secondary: rgba(255, 255, 255, 0.75);
    --text-muted:     rgba(255, 255, 255, 0.50);
    --border:         rgba(255, 255, 255, 0.22);

    position: relative;
    margin: -60px -80px 0;
    padding: 60px 80px 80px; /* 80px = SVG 높이만큼 overlap 여백 */
  }

  /* 배경 이미지: 80% 투명도 */
  .post-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0.2;
    pointer-events: none;
  }

  .post-hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  /* ── 경계선 SVG ─────────────────────────────────
     margin-top: -80px → 히어로 padding-bottom 영역을 덮어
     사진이 곡선 경계선 모양대로 잘린 효과 생성
  ─────────────────────────────────────────────── */
  .post-wave {
    display: block;
    width: calc(100% + 160px);
    height: 80px;
    margin: -80px -80px 0;
    position: relative;
    z-index: 1;
  }

  .wv-fill { fill: var(--bg); }

  /* 두꺼운 소프트 글로우 */
  .wv-ambient {
    fill: none;
    stroke: #c9a227;
    stroke-width: 12;
    stroke-opacity: 0.07;
    stroke-linecap: round;
  }

  /* 주 곡선 (두께 + shimmer) */
  .wv-stroke {
    fill: none;
    stroke-width: 3.5;
    stroke-linecap: round;
  }

  /* ── 본문 ───────────────────────────────────────── */
  .post-body { padding-top: 40px; }

  /* ── 하단 네비 ──────────────────────────────────── */
  .post-nav {
    margin-top: 60px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  /* ── 모바일 ─────────────────────────────────────── */
  @media (max-width: 1024px) {
    .post-hero {
      margin: -28px -16px 0;
      padding: 28px 16px 80px;
    }
    .post-wave {
      width: calc(100% + 32px);
      margin: -80px -16px 0;
    }
    .post-float-bar { left: 12px; right: 12px; }
  }

  /* ── 플로팅 바 ──────────────────────────────────── */
  .post-float-bar {
    position: fixed;
    top: 14px;
    left: calc(var(--sidebar-w) + 24px);
    right: 24px;
    height: 52px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 12px 0 6px;
    background: color-mix(in srgb, var(--bg) 97%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(201, 162, 39, 0.22);
    border-radius: 12px;
    box-shadow: 0 4px 28px rgba(0, 0, 0, 0.40);
    z-index: 100;
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.28s ease, opacity 0.28s ease;
  }

  .post-float-bar.is-visible {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .pfb-logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 8px;
    transition: background 0.18s;
  }
  .pfb-logo:hover { background: rgba(201, 162, 39, 0.12); }

  .pfb-fox {
    width: 28px;
    height: 28px;
    background: linear-gradient(90deg,
      #2e6bbf 0%, #6aaef5 30%, #c0e4ff 50%, #6aaef5 70%, #2e6bbf 100%);
    background-size: 200% 100%;
    -webkit-mask-image: url('/fox-mask.png');
    mask-image: url('/fox-mask.png');
    -webkit-mask-size: contain;    mask-size: contain;
    -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
    -webkit-mask-position: center;  mask-position: center;
    animation: pfb-fox-shimmer 4s linear infinite;
  }

  @keyframes pfb-fox-shimmer {
    from { background-position: 100% 0; }
    to   { background-position: -100% 0; }
  }

  .pfb-title {
    flex: 1;
    font-family: var(--font);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
    letter-spacing: 0.01em;
  }

  .pfb-actions {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .pfb-btn {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    color: var(--text-secondary);
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.18s, color 0.18s;
  }
  .pfb-btn:hover {
    background: rgba(201, 162, 39, 0.12);
    color: var(--accent);
  }
  .pfb-btn svg { width: 18px; height: 18px; }
</style>

<script>
  /*
   * 파도 물결 애니메이션
   *
   * 3개의 사인파를 중첩해 배경 캔버스의 바다처럼 유기적으로 물결치게 함.
   *   - 파1(주파): 큰 진폭, 왼쪽으로 이동 (dominant swell)
   *   - 파2(반대): 중간 진폭, 오른쪽으로 이동 (cross-swell)
   *   - 파3(장파): 작은 진폭, 긴 파장, 왼쪽 이동 (background roll)
   *
   * 매 프레임 d 속성을 직접 갱신 (x=0~1200, 6px 간격 = 201점).
   */

  const fillEl    = document.getElementById('wv-fill-path');
  const ambientEl = document.getElementById('wv-ambient-path');
  const strokeEl  = document.getElementById('wv-stroke-path');

  if (fillEl && ambientEl && strokeEl) {
    const W        = 1200;
    const SVG_H    = 80;
    const BASELINE = 50;
    const STEP     = 6;

    function getY(x: number, t: number): number {
      return (
        BASELINE
        + 13 * Math.sin(0.0072 * x + 0.32 * t)        // 주 파도 (좌행)
        +  5 * Math.sin(0.0140 * x - 0.21 * t + 1.3)  // 교차 파도 (우행)
        +  3 * Math.sin(0.0031 * x + 0.18 * t + 2.7)  // 장파 배경 (좌행)
      );
    }

    function buildStroke(t: number): string {
      let d = '';
      for (let x = 0; x <= W; x += STEP) {
        const y = getY(x, t).toFixed(2);
        d += x === 0 ? `M0,${y}` : ` L${x},${y}`;
      }
      return d;
    }

    let start: number | null = null;

    function frame(ts: number) {
      if (start === null) start = ts;
      const t = (ts - start) / 1000;
      const stroke = buildStroke(t);
      const fill   = `${stroke} L${W},${SVG_H} L0,${SVG_H} Z`;
      fillEl!.setAttribute('d', fill);
      ambientEl!.setAttribute('d', stroke);
      strokeEl!.setAttribute('d', stroke);
      requestAnimationFrame(frame);
    }

    requestAnimationFrame(frame);
  }

  /* ── 플로팅 바 ── */
  const floatBar = document.getElementById('post-float-bar');
  const pfbUp    = document.getElementById('pfb-up');
  const pfbDown  = document.getElementById('pfb-down');

  if (floatBar) {
    function updateBar() {
      const visible = window.scrollY > 200;
      floatBar.classList.toggle('is-visible', visible);
      floatBar.setAttribute('aria-hidden', visible ? 'false' : 'true');
    }

    window.addEventListener('scroll', updateBar, { passive: true });
    updateBar();

    pfbUp?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    pfbDown?.addEventListener('click', () => {
      window.scrollTo({ top: document.documentElement.scrollHeight, behavior: 'smooth' });
    });
  }

</script>
