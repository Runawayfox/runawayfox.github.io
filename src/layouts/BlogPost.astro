---
import Layout from './Layout.astro';
import TagPill from '../components/TagPill.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, pubDate, updatedDate, description, tags } = post.data;
const formattedDate = pubDate.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={title} description={description}>
  <main class="max-w-3xl mx-auto px-4 py-12">
    <article>
      <header class="mb-10">
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-4">
            {tags.map(tag => <TagPill tag={tag} />)}
          </div>
        )}
        <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-3 leading-tight">
          {title}
        </h1>
        <div class="flex items-center gap-4 text-sm text-slate-400 dark:text-slate-500">
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          {updatedDate && (
            <span>
              수정: {updatedDate.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}
            </span>
          )}
        </div>
      </header>

      <div class="prose prose-slate dark:prose-invert max-w-none prose-headings:font-bold prose-a:text-blue-600 dark:prose-a:text-blue-400">
        <slot />
      </div>
    </article>

    <nav class="mt-12 pt-6 border-t border-slate-200 dark:border-slate-700">
      <a href="/blog" class="text-sm text-blue-600 dark:text-blue-400 hover:underline">
        ← 모든 글 보기
      </a>
    </nav>
  </main>
</Layout>
