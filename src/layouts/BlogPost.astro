---
import Layout from './Layout.astro';
import TagPill from '../components/TagPill.astro';
import QuoteCard from '../components/QuoteCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, pubDate, updatedDate, description, tags, image } = post.data;
const formattedDate = pubDate.toLocaleDateString('ko-KR', {
  year: 'numeric', month: 'long', day: 'numeric',
});
const updatedFormatted = updatedDate?.toLocaleDateString('ko-KR', {
  year: 'numeric', month: 'long', day: 'numeric',
});

/*
 * 완만한 S자 곡선 경계선
 * ViewBox 0 0 1200 80  /  기준선 y=50
 * 전반 (0→600): 아래로 볼록 (트로프 y≈67)
 * 후반 (600→1200): 위로 볼록 (피크 y≈33)
 */
const WAVE_STROKE = 'M0,50 C100,72 500,72 600,50 C700,28 1100,28 1200,50';
const WAVE_FILL   = WAVE_STROKE + ' L1200,80 L0,80 Z';
---

<Layout title={title} description={description}>

  <!-- ── 제목 영역 ──────────────────────────────────────── -->
  <div class="post-hero">
    {image && (
      <div
        class="post-hero-bg"
        style={`background-image: url('${image}');`}
        aria-hidden="true"
      ></div>
    )}
    <a href="/blog" class="back-link">← Blog</a>
    {tags.length > 0 && (
      <div class="post-hero-tags">
        {tags.map(tag => <TagPill tag={tag} />)}
      </div>
    )}
    <h1 class="post-article-title">{title}</h1>
    <div class="post-article-meta">
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      {updatedDate && <span>수정: {updatedFormatted}</span>}
    </div>
  </div>

  <!-- ── S자 곡선 경계선 + 느린 금색 Shimmer ──────────────
       wave-fill : 본문 배경(--bg)으로 채워 히어로 사진을
                   곡선 모양대로 자르는 효과
       wave-ambient : 두꺼운 소프트 글로우 레이어
       wave-stroke  : 주 금색 선 (shimmer 그라디언트 적용)
  ──────────────────────────────────────────────────────── -->
  <svg
    class="post-wave"
    viewBox="0 0 1200 80"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <defs>
      <!-- 글로우 블러 필터 -->
      <filter id="wv-glow" x="-6%" y="-150%" width="112%" height="400%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="3.5" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>

      <!--
        Shimmer 그라디언트:
        - x1=-200 ~ x2=200 (400px 폭, 중심 x=0이 가장 밝음)
        - animateTransform translate: -600→2000 (8초, 느린 스윕)
        - 화면 밖 구간(총 8초 중 약 4.4초)에서는 기본 금색(35% 불투명)으로 표시
      -->
      <linearGradient
        id="wv-shimmer"
        gradientUnits="userSpaceOnUse"
        x1="-200" y1="0"
        x2="200"  y2="0"
      >
        <stop offset="0%"   stop-color="#c9a227" stop-opacity="0.35"/>
        <stop offset="35%"  stop-color="#ddb830" stop-opacity="0.55"/>
        <stop offset="50%"  stop-color="#fff8c0" stop-opacity="1.00"/>
        <stop offset="65%"  stop-color="#ddb830" stop-opacity="0.55"/>
        <stop offset="100%" stop-color="#c9a227" stop-opacity="0.35"/>
        <animateTransform
          attributeName="gradientTransform"
          type="translate"
          from="-600 0"
          to="2000 0"
          dur="8s"
          repeatCount="indefinite"
        />
      </linearGradient>
    </defs>

    <!-- 본문 배경으로 채운 영역 -->
    <path class="wv-fill" d={WAVE_FILL}/>

    <!-- 두꺼운 ambient 글로우 (입체감) -->
    <path class="wv-ambient" d={WAVE_STROKE} filter="url(#wv-glow)"/>

    <!-- 주 곡선 + Shimmer -->
    <path
      class="wv-stroke"
      d={WAVE_STROKE}
      stroke="url(#wv-shimmer)"
      filter="url(#wv-glow)"
    />
  </svg>

  <!-- ── 본문 ──────────────────────────────────────────── -->
  <div class="post-body">
    <QuoteCard />
    <article>
      <div class="prose prose-sm max-w-none">
        <slot />
      </div>
    </article>
  </div>

  <!-- ── 하단 네비 ─────────────────────────────────────── -->
  <div class="post-nav">
    <a href="/blog" class="back-link" style="margin-bottom:0">← 모든 글 보기</a>
  </div>

</Layout>

<style>
  /* ── 제목 영역 ──────────────────────────────────── */
  .post-hero {
    background: #060822;
    --text-primary:   #ffffff;
    --text-secondary: rgba(255, 255, 255, 0.75);
    --text-muted:     rgba(255, 255, 255, 0.50);
    --border:         rgba(255, 255, 255, 0.22);

    position: relative;
    margin: -60px -80px 0;
    padding: 60px 80px 80px; /* 80px = SVG 높이만큼 overlap 여백 */
  }

  /* 배경 이미지: 80% 투명도 */
  .post-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0.2;
    pointer-events: none;
  }

  .post-hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  /* ── 경계선 SVG ─────────────────────────────────
     margin-top: -80px → 히어로 padding-bottom 영역을 덮어
     사진이 곡선 경계선 모양대로 잘린 효과 생성
  ─────────────────────────────────────────────── */
  .post-wave {
    display: block;
    width: calc(100% + 160px);
    height: 80px;
    margin: -80px -80px 0;
    position: relative;
    z-index: 1;
  }

  .wv-fill { fill: var(--bg); }

  /* 두꺼운 소프트 글로우 */
  .wv-ambient {
    fill: none;
    stroke: #c9a227;
    stroke-width: 12;
    stroke-opacity: 0.07;
    stroke-linecap: round;
  }

  /* 주 곡선 (두께 + shimmer) */
  .wv-stroke {
    fill: none;
    stroke-width: 3.5;
    stroke-linecap: round;
  }

  /* ── 본문 ───────────────────────────────────────── */
  .post-body { padding-top: 40px; }

  /* ── 하단 네비 ──────────────────────────────────── */
  .post-nav {
    margin-top: 60px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  /* ── 모바일 ─────────────────────────────────────── */
  @media (max-width: 1024px) {
    .post-hero {
      margin: -28px -16px 0;
      padding: 28px 16px 80px;
    }
    .post-wave {
      width: calc(100% + 32px);
      margin: -80px -16px 0;
    }
  }
</style>
