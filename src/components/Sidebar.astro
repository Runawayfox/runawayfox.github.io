---
const nav = [
  { href: '/',     label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/tags', label: 'Tags' },
];

const path = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
}
---

<aside class="app-brand">
  <canvas id="sidebar-canvas"></canvas>
  <a href="/" class="fox-logo-wrap">
    <div class="fox-logo-img"></div>
    <div class="brand-text-group">
      <span class="brand-text">KITSUNE</span>
      <span class="brand-sub">HIDEOUT</span>
    </div>
  </a>

  <!-- Sidebar search (desktop) -->
  <form class="sidebar-search" action="/search" method="get" role="search">
    <div class="sidebar-search-wrap">
      <svg class="sidebar-search-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
      </svg>
      <input type="text" name="q" class="sidebar-search-input" placeholder="Search..." autocomplete="off" spellcheck="false" />
    </div>
  </form>

  <!-- Nav (desktop) -->
  <nav class="nav-buttons">
    {nav.map(item => (
      <a href={item.href} class:list={['nav-btn', { active: isActive(item.href) }]}>
        {item.label}
      </a>
    ))}
  </nav>

  <!-- Theme toggle (desktop) -->
  <div class="theme-toggle-wrap desktop-toggle">
    <span class="toggle-label-ko active" id="label-light">라이트</span>
    <button id="theme-toggle" class="theme-switch is-light" aria-label="테마 전환" aria-checked="true">
      <span class="theme-switch-thumb"></span>
    </button>
    <span class="toggle-label-ko" id="label-dark">다크</span>
  </div>

  <!-- Hamburger button (mobile only) -->
  <button class="hamburger-btn" id="hamburger-btn" aria-label="메뉴 열기" aria-expanded="false">
    <span></span>
    <span></span>
    <span></span>
  </button>
</aside>

<!-- Mobile dropdown (sibling of aside, outside overflow:hidden) -->
<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <form class="mobile-search-form" action="/search" method="get" role="search">
    <div class="sidebar-search-wrap">
      <svg class="sidebar-search-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
      </svg>
      <input type="text" name="q" class="sidebar-search-input" placeholder="Search..." autocomplete="off" spellcheck="false" />
    </div>
  </form>
  <nav class="mobile-nav">
    {nav.map(item => (
      <a href={item.href} class:list={['mobile-nav-btn', { active: isActive(item.href) }]}>
        {item.label}
      </a>
    ))}
    <button id="theme-toggle-text-m" type="button" class="mobile-nav-btn theme-text-btn">
      다크 모드로 전환
    </button>
  </nav>
</div>

<script is:inline>
  /* ── Sidebar cosmic canvas ── */
  (function () {
    var canvas = document.getElementById('sidebar-canvas');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    var W = 0, H = 0;

    /* 흰색/회색 별 (색상 없음) */
    var STAR_COUNT = 100;
    var stars = [];
    for (var i = 0; i < STAR_COUNT; i++) {
      stars.push({
        x:     Math.random(),
        y:     Math.random(),
        r:     Math.random() * 1.2 + 0.2,
        speed: 0.0000050 + Math.random() * 0.0000040,
        phase: Math.random() * 6.28,
        base:  0.10 + Math.random() * 0.42,
      });
    }

    function resize() {
      W = canvas.width  = canvas.offsetWidth;
      H = canvas.height = canvas.offsetHeight;
    }

    var prev = null;
    function frame(ts) {
      var dt = prev ? Math.min(ts - prev, 50) : 16;
      prev = ts;

      /* 검은색/회색 정적 그라데이션 (색상 사이클 없음) */
      var skyGrad = ctx.createLinearGradient(0, 0, W, H);
      skyGrad.addColorStop(0,   '#141418');
      skyGrad.addColorStop(0.5, '#0a0a0e');
      skyGrad.addColorStop(1,   '#040406');
      ctx.fillStyle = skyGrad;
      ctx.fillRect(0, 0, W, H);

      /* 회백색 별 드리프트 */
      for (var i = 0; i < stars.length; i++) {
        var s = stars[i];
        s.x -= s.speed * dt;
        if (s.x < -0.02) { s.x = 1.02; s.y = Math.random(); }

        var flicker = 0.55 + 0.45 * Math.sin(ts * 0.0011 + s.phase);
        var a = s.base * flicker;
        var px = s.x * W;
        var py = s.y * H;

        ctx.fillStyle = 'rgba(210,215,225,' + a + ')';
        ctx.beginPath();
        ctx.arc(px, py, s.r, 0, 6.28);
        ctx.fill();
      }

      requestAnimationFrame(frame);
    }

    window.addEventListener('resize', resize);
    resize();
    requestAnimationFrame(frame);
  })();
</script>

<script is:inline>
  /* ── Theme toggle (desktop switch + mobile text button) ── */
  (function () {
    var html = document.documentElement;

    var btn      = document.getElementById('theme-toggle');
    var lblLight = document.getElementById('label-light');
    var lblDark  = document.getElementById('label-dark');
    var textBtnM = document.getElementById('theme-toggle-text-m');

    function applyUI(isLight) {
      /* 데스크탑 토글 스위치 */
      if (btn) {
        btn.setAttribute('aria-checked', isLight ? 'true' : 'false');
        if (isLight) btn.classList.add('is-light');
        else btn.classList.remove('is-light');
      }
      function setLabel(lbl, active) {
        if (!lbl) return;
        if (active) lbl.classList.add('active');
        else lbl.classList.remove('active');
      }
      setLabel(lblLight, isLight);
      setLabel(lblDark,  !isLight);

      /* 모바일 텍스트 버튼 */
      if (textBtnM) {
        textBtnM.textContent = isLight ? '다크 모드로 전환' : '라이트 모드로 전환';
      }
    }

    applyUI(html.classList.contains('light'));

    function handleClick() {
      var nowLight = html.classList.toggle('light');
      localStorage.setItem('theme', nowLight ? 'light' : 'dark');
      applyUI(nowLight);
    }

    if (btn)     btn.addEventListener('click', handleClick);
    if (textBtnM) textBtnM.addEventListener('click', handleClick);
  })();
</script>

<script is:inline>
  /* ── Hamburger menu ── */
  (function () {
    var hBtn = document.getElementById('hamburger-btn');
    var menu = document.getElementById('mobile-menu');
    if (!hBtn || !menu) return;

    function closeMenu() {
      menu.classList.remove('is-open');
      hBtn.classList.remove('is-open');
      hBtn.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-hidden', 'true');
    }

    hBtn.addEventListener('click', function () {
      var isOpen = !menu.classList.contains('is-open');
      menu.classList.toggle('is-open', isOpen);
      hBtn.classList.toggle('is-open', isOpen);
      hBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      menu.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
    });

    var links = menu.querySelectorAll('a');
    for (var i = 0; i < links.length; i++) {
      links[i].addEventListener('click', closeMenu);
    }
  })();
</script>
