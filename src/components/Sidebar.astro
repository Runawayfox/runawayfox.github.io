---
const nav = [
  { href: '/',     label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/tags', label: 'Tags' },
];

const path = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
}
---

<aside class="app-brand">
  <canvas id="sidebar-canvas"></canvas>

  <a href="/" class="fox-logo-wrap">
    <div class="fox-logo-img"></div>
    <div class="brand-text-group">
      <span class="brand-text">KITSUNE</span>
      <span class="brand-sub">HIDEOUT</span>
    </div>
  </a>

  <!-- Sidebar search (desktop) -->
  <form class="sidebar-search" action="/search" method="get" role="search">
    <div class="sidebar-search-wrap">
      <svg class="sidebar-search-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
      </svg>
      <input type="text" name="q" class="sidebar-search-input" placeholder="Search..." autocomplete="off" spellcheck="false" />
    </div>
  </form>

  <!-- Nav (desktop) -->
  <nav class="nav-buttons">
    {nav.map(item => (
      <a href={item.href} class:list={['nav-btn', { active: isActive(item.href) }]}>
        {item.label}
      </a>
    ))}
  </nav>

  <!-- Theme toggle (desktop) -->
  <div class="theme-toggle-wrap desktop-toggle">
    <span class="toggle-label-ko active" id="label-light">라이트</span>
    <button id="theme-toggle" class="theme-switch is-light" aria-label="테마 전환" aria-checked="true">
      <span class="theme-switch-thumb"></span>
    </button>
    <span class="toggle-label-ko" id="label-dark">다크</span>
  </div>

  <!-- Hamburger button (mobile only) -->
  <button class="hamburger-btn" id="hamburger-btn" aria-label="메뉴 열기" aria-expanded="false">
    <span></span>
    <span></span>
    <span></span>
  </button>
</aside>

<!-- Mobile dropdown (sibling of aside, outside overflow:hidden) -->
<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <!-- Theme toggle (mobile, inside dropdown) -->
  <div class="theme-toggle-wrap mobile-toggle">
    <span class="toggle-label-ko active" id="label-light-m">라이트</span>
    <button id="theme-toggle-m" class="theme-switch is-light" aria-label="테마 전환" aria-checked="true">
      <span class="theme-switch-thumb"></span>
    </button>
    <span class="toggle-label-ko" id="label-dark-m">다크</span>
  </div>

  <form class="mobile-search-form" action="/search" method="get" role="search">
    <div class="sidebar-search-wrap">
      <svg class="sidebar-search-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
      </svg>
      <input type="text" name="q" class="sidebar-search-input" placeholder="Search..." autocomplete="off" spellcheck="false" />
    </div>
  </form>
  <nav class="mobile-nav">
    {nav.map(item => (
      <a href={item.href} class:list={['mobile-nav-btn', { active: isActive(item.href) }]}>
        {item.label}
      </a>
    ))}
  </nav>
</div>

<script is:inline>
  /* ── Sidebar cosmic canvas ── */
  (function () {
    var canvas = document.getElementById('sidebar-canvas');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    var W = 0, H = 0;

    /* 8 star color types: cyan + magenta added */
    var TYPES = [
      { r:215, g:225, b:255 },  /* blue-white */
      { r:255, g:245, b:200 },  /* warm white */
      { r:245, g:200, b:65  },  /* gold       */
      { r:255, g:140, b:65  },  /* orange     */
      { r:255, g:80,  b:70  },  /* red        */
      { r:185, g:150, b:255 },  /* violet     */
      { r:75,  g:205, b:235 },  /* cyan       */
      { r:255, g:110, b:185 },  /* magenta    */
    ];
    var WEIGHTS = [0.24, 0.16, 0.16, 0.10, 0.08, 0.12, 0.08, 0.06];

    function pickType() {
      var v = Math.random(), sum = 0;
      for (var k = 0; k < WEIGHTS.length; k++) {
        sum += WEIGHTS[k];
        if (v < sum) return k;
      }
      return 0;
    }

    var STAR_COUNT = 120;
    var stars = [];
    for (var i = 0; i < STAR_COUNT; i++) {
      var ti = pickType();
      stars.push({
        x:     Math.random(),
        y:     Math.random(),
        r:     Math.random() * 1.4 + 0.25,
        speed: 0.0000055 + Math.random() * 0.0000048,
        phase: Math.random() * 6.28,
        ti:    ti,
        base:  0.12 + Math.random() * 0.52,
        glow:  Math.random() < 0.38,
      });
    }

    /* 6 nebulae: violet, rose, cyan, gold, deep-purple, emerald */
    var nebulae = [
      { nx:0.45, ny:0.12, nr:1.00, r:115, g:65,  b:230, sp:0.0000025, ph:0.0  },
      { nx:0.72, ny:0.38, nr:0.88, r:220, g:55,  b:120, sp:0.0000020, ph:2.1  },
      { nx:0.28, ny:0.65, nr:0.82, r:45,  g:170, b:215, sp:0.0000016, ph:4.2  },
      { nx:0.82, ny:0.06, nr:0.72, r:210, g:158, b:48,  sp:0.0000030, ph:1.0  },
      { nx:0.18, ny:0.88, nr:0.68, r:130, g:50,  b:205, sp:0.0000022, ph:3.0  },
      { nx:0.88, ny:0.55, nr:0.62, r:45,  g:185, b:148, sp:0.0000018, ph:5.5  },
    ];

    function resize() {
      W = canvas.width  = canvas.offsetWidth;
      H = canvas.height = canvas.offsetHeight;
    }

    var SKY_DRIFT = 0.0000078;

    var prev = null;
    function frame(ts) {
      var dt = prev ? Math.min(ts - prev, 50) : 16;
      prev = ts;

      /* Multi-wave colour cycle: violet / teal / indigo */
      var t  = ts * 0.000013;
      var c1 = Math.max(0, Math.sin(t));
      var c2 = Math.max(0, Math.sin(t * 0.68 + 2.0));
      var c3 = Math.max(0, Math.sin(t * 0.45 + 4.1));
      var br = Math.round(4  + c1 * 22 + c3 * 8);
      var bg = Math.round(5  + c2 * 14 + c1 * 4);
      var bb = Math.round(22 + c2 * 24 + c3 * 16);
      var skyGrad = ctx.createLinearGradient(0, 0, 0, H);
      skyGrad.addColorStop(0,   'rgb('+(br+8)+','+(bg+3)+','+(bb+10)+')');
      skyGrad.addColorStop(0.5, 'rgb('+br+','+bg+','+bb+')');
      skyGrad.addColorStop(1,   'rgb('+Math.max(br-2,2)+','+Math.max(bg-2,2)+','+Math.max(bb-4,16)+')');
      ctx.fillStyle = skyGrad;
      ctx.fillRect(0, 0, W, H);

      /* Drift nebulae left */
      for (var n = 0; n < nebulae.length; n++) {
        var nb = nebulae[n];
        nb.nx -= nb.sp * dt;
        if (nb.nx < -(nb.nr * 0.6)) nb.nx = 1 + nb.nr * 0.6;
        var pulse = 0.46 + 0.54 * Math.sin(ts * 0.00022 + nb.ph);
        var ng = ctx.createRadialGradient(nb.nx*W, nb.ny*H, 0, nb.nx*W, nb.ny*H, nb.nr*W);
        ng.addColorStop(0,    'rgba('+nb.r+','+nb.g+','+nb.b+','+(0.082*pulse)+')');
        ng.addColorStop(0.42, 'rgba('+nb.r+','+nb.g+','+nb.b+','+(0.034*pulse)+')');
        ng.addColorStop(1,    'rgba('+nb.r+','+nb.g+','+nb.b+',0)');
        ctx.fillStyle = ng;
        ctx.beginPath();
        ctx.arc(nb.nx*W, nb.ny*H, nb.nr*W, 0, 6.28);
        ctx.fill();
      }

      /* Drift stars left */
      for (var i = 0; i < stars.length; i++) {
        var s = stars[i];
        s.x -= s.speed * dt;
        if (s.x < -0.02) { s.x = 1.02; s.y = Math.random(); }

        var flicker = 0.52 + 0.48 * Math.sin(ts * 0.0012 + s.phase);
        var a = s.base * flicker;
        var col = TYPES[s.ti];
        var px = s.x * W;
        var py = s.y * H;

        ctx.save();
        if (s.glow) {
          var grd = ctx.createRadialGradient(px, py, 0, px, py, s.r * 5);
          grd.addColorStop(0,    'rgba('+col.r+','+col.g+','+col.b+','+a+')');
          grd.addColorStop(0.38, 'rgba('+col.r+','+col.g+','+col.b+','+(a*0.25)+')');
          grd.addColorStop(1,    'rgba('+col.r+','+col.g+','+col.b+',0)');
          ctx.fillStyle = grd;
          ctx.beginPath();
          ctx.arc(px, py, s.r * 5, 0, 6.28);
          ctx.fill();
        }
        ctx.fillStyle = 'rgba('+col.r+','+col.g+','+col.b+','+a+')';
        ctx.beginPath();
        ctx.arc(px, py, s.r, 0, 6.28);
        ctx.fill();
        ctx.restore();
      }

      requestAnimationFrame(frame);
    }

    window.addEventListener('resize', resize);
    resize();
    requestAnimationFrame(frame);
  })();
</script>

<script is:inline>
  /* ── Theme toggle (syncs desktop + mobile instances) ── */
  (function () {
    var html = document.documentElement;

    var btn      = document.getElementById('theme-toggle');
    var lblLight = document.getElementById('label-light');
    var lblDark  = document.getElementById('label-dark');

    var btnM      = document.getElementById('theme-toggle-m');
    var lblLightM = document.getElementById('label-light-m');
    var lblDarkM  = document.getElementById('label-dark-m');

    function applyUI(isLight) {
      var buttons = [btn, btnM];
      buttons.forEach(function (b) {
        if (!b) return;
        b.setAttribute('aria-checked', isLight ? 'true' : 'false');
        if (isLight) b.classList.add('is-light');
        else b.classList.remove('is-light');
      });

      function setLabel(lbl, active) {
        if (!lbl) return;
        if (active) lbl.classList.add('active');
        else lbl.classList.remove('active');
      }
      setLabel(lblLight,  isLight);
      setLabel(lblDark,   !isLight);
      setLabel(lblLightM, isLight);
      setLabel(lblDarkM,  !isLight);
    }

    applyUI(html.classList.contains('light'));

    function handleClick() {
      var nowLight = html.classList.toggle('light');
      localStorage.setItem('theme', nowLight ? 'light' : 'dark');
      applyUI(nowLight);
    }

    if (btn)  btn.addEventListener('click', handleClick);
    if (btnM) btnM.addEventListener('click', handleClick);
  })();
</script>

<script is:inline>
  /* ── Hamburger menu ── */
  (function () {
    var hBtn = document.getElementById('hamburger-btn');
    var menu = document.getElementById('mobile-menu');
    if (!hBtn || !menu) return;

    function closeMenu() {
      menu.classList.remove('is-open');
      hBtn.classList.remove('is-open');
      hBtn.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-hidden', 'true');
    }

    hBtn.addEventListener('click', function () {
      var isOpen = !menu.classList.contains('is-open');
      menu.classList.toggle('is-open', isOpen);
      hBtn.classList.toggle('is-open', isOpen);
      hBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      menu.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
    });

    var links = menu.querySelectorAll('a');
    for (var i = 0; i < links.length; i++) {
      links[i].addEventListener('click', closeMenu);
    }
  })();
</script>
