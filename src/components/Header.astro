---
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { label: 'Blog', href: '/blog' },
  { label: 'Tags', href: '/tags' },
  { label: 'Search', href: '/search' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm border-b border-slate-200 dark:border-slate-700">
  <nav class="max-w-3xl mx-auto px-4 h-14 flex items-center justify-between">
    <a
      href="/"
      class="font-bold text-lg text-slate-900 dark:text-white hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
    >
      RunawayFox
    </a>
    <div class="flex items-center gap-1">
      {
        nav.map(item => (
          <a
            href={item.href}
            class:list={[
              'px-3 py-1.5 text-sm rounded-lg transition-colors',
              currentPath === item.href || currentPath.startsWith(item.href + '/')
                ? 'text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30'
                : 'text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <ThemeToggle />
    </div>
  </nav>
</header>
