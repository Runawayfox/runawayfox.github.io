---
// No props — quote is chosen client-side on every page load
---

<section class="quote-section" aria-label="오늘의 게임 디자인 명언">
  <div class="quote-card" id="quote-card">
    <div class="quote-mark" aria-hidden="true">❝</div>
    <blockquote class="quote-text" id="quote-text"></blockquote>
    <footer class="quote-attribution">
      <span class="quote-speaker" id="quote-speaker"></span>
    </footer>
  </div>
</section>

<script is:inline>
(function () {
  var QUOTES = [
    { text: "재미란 학습을 가리키는 또 다른 말이다.", speaker: "라프 코스터, 게임 이론가" },
    { text: "좋은 게임이란 플레이어가 그만두기 전에 게임이 가진 모든 것을 가르쳐주는 게임이다.", speaker: "라프 코스터, 게임 이론가" },
    { text: "지루함은 뇌가 '지금 내 시간을 낭비하고 있다'고 말하는 것이다.", speaker: "라프 코스터, 게임 이론가" },
    { text: "게임에서는 학습 그 자체가 마약이다.", speaker: "라프 코스터, 게임 이론가" },
    { text: "게임은 유희적 태도로 접근하는 문제 해결 활동이다.", speaker: "제시 쉘, 《The Art of Game Design》 저자" },
    { text: "게임 자체가 경험이 아니다. 게임은 경험을 만들어내는 것이다.", speaker: "제시 쉘, 《The Art of Game Design》 저자" },
    { text: "게임이 아닌 플레이어에 대해 생각하라.", speaker: "제시 쉘, 《The Art of Game Design》 저자" },
    { text: "게임은 흥미로운 선택들의 연속이다.", speaker: "시드 마이어, 〈문명〉 시리즈 제작자" },
    { text: "재미를 찾아라.", speaker: "시드 마이어, 〈문명〉 시리즈 제작자" },
    { text: "'불가능하다'고 여겨지는 것의 90%는 사실 가능하다. 나머지 10%는 시간과 기술의 발전과 함께 가능해질 것이다.", speaker: "코지마 히데오, 〈데스 스트랜딩〉 시리즈 제작자" },
    { text: "내 게임이 단순히 '재미있는' 것에만 그치지 않기를 바란다. 플레이어가 가져가고 활용할 수 있는 메시지나 핵심을 담고 싶다.", speaker: "코지마 히데오, 〈데스 스트랜딩〉 시리즈 제작자" },
    { text: "나는 게임을 새로운 예술 형식으로 본다. 모든 예술 형식을 결합하고 여기에 플레이어의 주체성을 더한 것.", speaker: "코지마 히데오, 〈데스 스트랜딩〉 시리즈 제작자" },
    { text: "사람들이 주변 세계에 대해 생각하게 만들고 싶다. 그 안에서 실험해볼 수 있는 작은 장난감 세계를 통해서.", speaker: "윌 라이트, 〈심시티〉 제작자" },
    { text: "게임 디자이너의 역할은, 게임 시스템을 실현할 기술을 먼저 이해한 후 완전한 게임 시스템을 설계하는 것이라는 결론에 이르렀다.", speaker: "미야모토 시게루, 닌텐도 게임 디자이너" },
    { text: "집을 지을 때 2층부터 작업하듯, 나는 게임의 후반부를 더 재미있게 만드는 데 더 많은 시간을 쏟으려 한다.", speaker: "미야모토 시게루, 닌텐도 게임 디자이너" },
    { text: "물론 나도 〈헤일로〉를 만들 수 있다. 1인칭 슈팅 게임을 생각해본 적이 없는 게 아니니까.", speaker: "미야모토 시게루, 닌텐도 게임 디자이너" },
    { text: "게임은 규칙으로 정의된 인위적인 갈등 속에 플레이어가 참여하여 수치화 가능한 결과를 낳는 시스템이다.", speaker: "케이티 세일런 & 에릭 짐머만, 《Rules of Play》 저자" },
    { text: "놀이는 더 엄격한 구조 안에서의 자유로운 움직임이다.", speaker: "케이티 세일런 & 에릭 짐머만, 게임 연구자" },
    { text: "게임을 한다는 것은 불필요한 장애물을 극복하려는 자발적인 시도다.", speaker: "버나드 수츠, 철학자·《메뚜기》 저자" },
    { text: "놀이는 '진지하지 않은 것'으로서 일상 밖에 의식적으로 존재하는 자유로운 활동이면서도, 동시에 플레이어를 완전히 몰입시킨다.", speaker: "요한 하위징아, 역사가·《호모 루덴스》 저자" },
    { text: "게임 디자인은 단순한 기술적 작업이 아니다. 그것은 21세기의 사고방식이자 리더십이다.", speaker: "제인 맥고니걸, 게임 연구자" },
    { text: "게임이 우리를 행복하게 만드는 이유는, 그것이 우리 스스로 선택한 힘든 노동이기 때문이다. 그리고 좋은 힘든 노동만큼 우리를 행복하게 하는 것은 거의 없다.", speaker: "제인 맥고니걸, 《현실은 부서졌다》 저자" },
    { text: "비디오 게임은 반(半)현실이다. 플레이어가 실제로 상호작용하는 실제 규칙과, 그 규칙이 투영하는 허구적 세계로 이루어져 있다.", speaker: "예스퍼 율, 게임 이론가" },
    { text: "〈데우스 엑스〉를 만들 때 나의 숨겨진 목표는 다른 개발자들을 부끄럽게 만드는 것이었다.", speaker: "워런 스펙터, 〈데우스 엑스〉 디렉터" },
    { text: "플레이어를 절대 판단하지 마라.", speaker: "워런 스펙터, 〈데우스 엑스〉 디렉터" },
    { text: "관객에게 무엇을 해야 하는지 물어서는 안 된다. 그들은 많은 맥락을 알지 못하기 때문이다.", speaker: "켄 레빈, 〈바이오쇼크〉 시리즈 제작자" },
    { text: "기회가 주어진다면, 플레이어는 게임에서 재미를 최적화해 없애버릴 것이다.", speaker: "소렌 존슨, 〈문명 IV〉 수석 디자이너" },
    { text: "게임은 네 가지 특성으로 정의된다. 표현, 상호작용, 갈등, 그리고 안전.", speaker: "크리스 크로퍼드, 《컴퓨터 게임 디자인의 기술》 저자" },
    { text: "놀이는 순수한 낭비의 기회다. 시간, 에너지, 독창성, 기술, 그리고 종종 돈의 낭비.", speaker: "로제 카유아, 사회학자·《놀이와 인간》 저자" },
    { text: "비디오 게임은 단어나 이미지가 아닌, 게임이 모델링하는 과정과 시스템을 통해 세계에 대한 주장을 펼친다.", speaker: "이언 보고스트, 미디어 이론가" },
    { text: "진정한 역경을 극복하는 과정을 통해 플레이어에게 진짜 성취감을 주고 싶었다.", speaker: "미야자키 히데타카, 〈다크 소울〉 시리즈 디렉터" },
    { text: "나의 접근 방식은 빼기의 디자인이다. 감정적 경험에 필수적이지 않은 모든 것을 제거하는 것.", speaker: "우에다 후미토, 〈이코〉·〈완다와 거상〉 디렉터" },
    { text: "컷신뿐만 아니라 플레이어의 행동을 통해 서사를 경험하게 하고 싶다.", speaker: "닐 드럭만, 〈더 라스트 오브 어스〉 디렉터" },
    { text: "게임의 모든 요소는 존재 이유를 증명해야 한다. 왜 있는지 설명할 수 없다면 빼라.", speaker: "사쿠라이 마사히로, 〈슈퍼 스매시브라더스〉 시리즈 디렉터" },
    { text: "〈저니〉는 나이나 문화에 상관없이 누구나 함께 나누고 이해할 수 있는 경험으로 설계되었다.", speaker: "제노바 첸, 〈저니〉 제작자" },
    { text: "여성이 좋아하는 것을 생각했다. 음식을 생각했다. 귀여운 것들을 생각했다. 그렇게 팩맨이 탄생했다.", speaker: "이와타니 토루, 〈팩맨〉 제작자" },
    { text: "어떤 게임에서든 가장 강렬한 순간은 플레이어가 자신의 선택이 실제로 중요하다는 것을 깨달을 때다.", speaker: "피터 몰리뉴, 〈페이블〉 시리즈 제작자" },
    { text: "다른 사람이 게임을 플레이하는 것을 볼 때까지는 게임이 제대로 작동하는지 알 수 없다. 그때 비로소 명확하게 보인다.", speaker: "조던 메크너, 〈페르시아의 왕자〉 제작자" },
    { text: "어드벤처 게임은 비디오 게임이 당신을 울게 하고, 웃게 하고, 감정을 느끼게 할 수 있음을 증명했다. 그것이 나의 모든 접근 방식을 바꿨다.", speaker: "팀 셰퍼, 〈풀 스로틀〉·〈사이코너츠〉 제작자" },
    { text: "〈언차티드〉에서 우리의 목표는 영화적 스토리텔링과 의미 있는 플레이어 주체성이 공존할 수 있음을 증명하는 것이었다.", speaker: "에이미 헤닉, 〈언차티드〉 크리에이티브 디렉터" },
    { text: "가장 중요한 디자인 통찰은 누군가가 처음으로 당신의 프로토타입을 플레이하는 것을 지켜볼 때 얻는다.", speaker: "마크 서니, 〈크래쉬 밴디쿳〉 프로듀서" },
    { text: "플레이어야말로 가상 세계를 살아 있는 공간으로 만드는 존재다. 플레이어 없이는 그저 건축물에 불과하다.", speaker: "리처드 바틀, MUD 공동 개발자" },
    { text: "내가 줄 수 있는 최고의 게임 디자인 조언은 먼저 툴을 만들라는 것이다. 훌륭한 툴이 훌륭한 게임을 낳는다.", speaker: "존 로메로, 〈둠〉·〈퀘이크〉 공동 개발자" },
    { text: "재미는 네 가지 원천에서 나온다. 어려운 도전, 쉬운 탐험, 개인적 성취, 그리고 사회적 연결이다.", speaker: "니콜 라자로, XEO디자인 창립자" },
    { text: "게임은 다른 어떤 매체도 표현할 수 없는 아이디어를 표현할 능력이 있다. 그것은 기회인 동시에 책임이다.", speaker: "조너선 블로, 〈브레이드〉·〈더 위트니스〉 제작자" },
    { text: "게임은 불확실성과 마주하기 위한 기술이다. 그것이 게임의 가장 깊은 가치다.", speaker: "프랭크 란츠, NYU 게임 센터 디렉터" },
    { text: "먼저 감정을 위해 디자인하라. 플레이어가 느끼길 원하는 것을 정확히 알면 다른 모든 결정이 쉬워진다.", speaker: "데이비드 재피, 〈갓 오브 워〉 시리즈 디렉터" },
    { text: "최고의 게임 디자인은 눈에 보이지 않는다. 모든 것이 제대로 작동할 때 플레이어는 디자인을 알아채지 못한다. 그저 좋은 느낌만 받을 뿐이다.", speaker: "클리프 블레진스키, 〈기어스 오브 워〉 수석 디자이너" },
    { text: "놀이는 세계와 관계 맺는 창의적인 방식이다. 게임은 그 관계 맺음을 위해 설계된 공간이다.", speaker: "메리 플래너건, 《Critical Play: Radical Game Design》 저자" },
    { text: "〈테트리스〉로 나는 플레이어가 항상 희망을 가질 수 있는 게임을 만들고 싶었다. 블록 하나가 모든 것을 구할 수도 있다는 희망을.", speaker: "알렉세이 파지트노프, 〈테트리스〉 제작자" },
  ];

  var q = QUOTES[Math.floor(Math.random() * QUOTES.length)];
  document.getElementById('quote-text').textContent    = q.text;
  document.getElementById('quote-speaker').textContent = q.speaker;
})();
</script>

<style>
.quote-section {
  margin-bottom: 48px;
  display: flex;
  justify-content: center;
}

.quote-section .quote-card {
  width: 67%;
}

.quote-card {
  position: relative;
  padding: 32px 36px 28px 52px;
  background: rgba(9, 16, 42, 0.55);
  backdrop-filter: blur(14px) saturate(1.3);
  -webkit-backdrop-filter: blur(14px) saturate(1.3);
  border: 1px solid rgba(192, 200, 218, 0.22);
  border-left: 3px solid rgba(192, 200, 218, 0.55);
  border-radius: 4px;
  overflow: hidden;
  box-shadow:
    inset 0 1px 0 rgba(215, 225, 250, 0.10),
    inset 0 -1px 0 rgba(150, 170, 220, 0.04),
    0 4px 24px rgba(0, 0, 0, 0.35),
    0 0 0 1px rgba(192, 200, 218, 0.06);
}

/* top-edge shimmer — light catching the glass surface */
.quote-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg,
    transparent              0%,
    rgba(220, 230, 255, 0.28) 20%,
    rgba(235, 242, 255, 0.45) 50%,
    rgba(220, 230, 255, 0.28) 80%,
    transparent              100%
  );
  pointer-events: none;
}

/* inner glow along left bezel */
.quote-card::after {
  content: '';
  position: absolute;
  top: 0; left: 0; bottom: 0;
  width: 40px;
  background: linear-gradient(90deg,
    rgba(192, 200, 218, 0.08) 0%,
    transparent              100%
  );
  pointer-events: none;
}

.quote-mark {
  position: absolute;
  top: 12px;
  left: 14px;
  font-size: 52px;
  line-height: 1;
  color: var(--accent);
  opacity: 0.72;
  font-family: Georgia, 'Times New Roman', serif;
  user-select: none;
}

.quote-text {
  margin: 0 0 20px;
  font-size: 17px;
  line-height: 1.75;
  color: var(--text-primary);
  font-style: italic;
  font-family: var(--font-content);
  letter-spacing: 0.01em;
}

.quote-attribution {
  display: flex;
  flex-direction: column;
  gap: 3px;
  padding-top: 14px;
  border-top: 1px solid rgba(192, 200, 218, 0.14);
}

.quote-speaker {
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: rgba(210, 218, 235, 0.85);
  font-family: var(--font);
  font-style: normal;
}

/* light mode */
html.light .quote-card {
  background: rgba(255, 255, 252, 0.55);
  border-color: rgba(201, 162, 39, 0.30);
  border-left-color: rgba(201, 162, 39, 0.65);
  box-shadow:
    inset 0 1px 0 rgba(255, 230, 120, 0.18),
    0 4px 20px rgba(0, 0, 0, 0.10),
    0 0 0 1px rgba(201, 162, 39, 0.08);
}
html.light .quote-card::before {
  background: linear-gradient(90deg,
    transparent              0%,
    rgba(255, 220, 100, 0.30) 20%,
    rgba(255, 235, 140, 0.48) 50%,
    rgba(255, 220, 100, 0.30) 80%,
    transparent              100%
  );
}
html.light .quote-card::after {
  background: linear-gradient(90deg,
    rgba(201, 162, 39, 0.08) 0%,
    transparent              100%
  );
}
html.light .quote-mark {
  color: var(--accent);
  opacity: 0.80;
}
html.light .quote-text    { color: var(--text-primary); }
html.light .quote-speaker { color: #333333; }
html.light .quote-attribution { border-top-color: rgba(201, 162, 39, 0.20); }
</style>
