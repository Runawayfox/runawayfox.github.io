---
import type { CollectionEntry } from 'astro:content';
import TagPill from './TagPill.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, pubDate, description, tags } = post.data;
const slug = post.id.replace(/\.mdx?$/, '');
const formattedDate = pubDate.toLocaleDateString('ko-KR', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<article class="post-card">
  <a href={`/blog/${slug}`} class="post-card-link">
    <h3 class="post-card-title">{title}</h3>
    <p class="post-card-desc">{description}</p>
  </a>
  <div class="post-card-meta">
    <time class="post-card-date" datetime={pubDate.toISOString()}>{formattedDate}</time>
    {tags.map(tag => <TagPill tag={tag} />)}
  </div>
</article>
