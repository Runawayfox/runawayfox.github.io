---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

// PostCard와 동일한 팔레트 기반 placeholder
function hashSlug(s: string): number {
  let h = 0;
  for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) & 0xffff;
  return h;
}
const PALETTES = [
  'radial-gradient(ellipse at 28% 38%, rgba(201,162,39,0.18) 0%, transparent 55%), radial-gradient(ellipse at 74% 68%, rgba(90,60,200,0.14) 0%, transparent 50%), linear-gradient(135deg, #06050f 0%, #0e0b02 55%, #050413 100%)',
  'radial-gradient(ellipse at 65% 30%, rgba(220,55,120,0.17) 0%, transparent 52%), radial-gradient(ellipse at 25% 72%, rgba(45,170,215,0.13) 0%, transparent 50%), linear-gradient(135deg, #0a0508 0%, #060a0d 60%, #04040e 100%)',
  'radial-gradient(ellipse at 35% 58%, rgba(45,185,148,0.16) 0%, transparent 55%), radial-gradient(ellipse at 72% 25%, rgba(130,50,205,0.14) 0%, transparent 50%), linear-gradient(135deg, #040a08 0%, #060410 55%, #040612 100%)',
  'radial-gradient(ellipse at 20% 42%, rgba(80,120,255,0.16) 0%, transparent 55%), radial-gradient(ellipse at 80% 65%, rgba(201,162,39,0.13) 0%, transparent 50%), linear-gradient(135deg, #040510 0%, #080614 55%, #030409 100%)',
  'radial-gradient(ellipse at 55% 25%, rgba(45,185,120,0.16) 0%, transparent 50%), radial-gradient(ellipse at 30% 75%, rgba(210,60,100,0.13) 0%, transparent 55%), linear-gradient(135deg, #040906 0%, #080408 60%, #040614 100%)',
];
---

<Layout title="Kitsune Hideout" isHome={true}>
  <!-- 모바일 전용 hero (canvas 위에 오버레이) — 데스크탑에서는 display:none -->
  <div class="mobile-home-hero" aria-hidden="true">
    <a href="/" class="fox-logo-wrap">
      <div class="fox-logo-img"></div>
      <div class="brand-text-group">
        <span class="brand-text">KITSUNE</span>
        <span class="brand-sub">HIDEOUT</span>
      </div>
    </a>

    <!-- 탭 + 검색 한 줄 바 -->
    <div class="mhh-bar" id="mhh-bar">
      <nav class="mhh-nav">
        <a href="/" class="nav-btn active">Home</a>
        <a href="/blog" class="nav-btn">Blog</a>
        <a href="/tags" class="nav-btn">Tags</a>
      </nav>

      <!-- 좌측 확장 검색 영역 (clip-path 애니메이션) -->
      <div class="mhh-search-expand" id="mhh-search-expand" aria-hidden="true">
        <form class="mhh-search-inner" action="/search" method="get" role="search">
          <input id="mhh-search-input" type="text" name="q" class="sidebar-search-input"
            placeholder="Search..." autocomplete="off" spellcheck="false" tabindex="-1" />
        </form>
      </div>

      <!-- 검색 아이콘 버튼 (우측 고정) -->
      <button class="mhh-search-btn" id="mhh-search-btn" type="button" aria-label="검색 열기" aria-expanded="false">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
      </button>
    </div>

    <!-- dots + 카드 래퍼 -->
    <div class="mhh-card-area">
      <!-- dot indicator: 카드 좌측, 카드 상단 기준 세로 배치 -->
      {posts.length > 1 && (
        <div class="mhh-dots" id="mhh-dots" aria-hidden="true">
          {posts.map((_, i) => <span class:list={['mhh-dot', { active: i === 0 }]}></span>)}
        </div>
      )}

      <!-- 히어로 포스트 카드 (스와이프로 교체) -->
      <div class="mhh-hero-card" id="mhh-hero-card">
        {posts.map((post, i) => {
          const slug = post.id.replace(/\.mdx?$/, '');
          const placeholder = PALETTES[hashSlug(slug) % PALETTES.length];
          return (
            <a
              href={`/blog/${slug}`}
              class="mhh-post-preview"
              aria-hidden="true"
              tabindex={-1}
            >
              {post.data.image
                ? <img src={post.data.image} alt={post.data.title} class="mpp-img" loading="lazy" />
                : <div class="mpp-img" style={`background: ${placeholder};`}></div>
              }
              <div class="mpp-content">
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="mpp-tags">
                    {post.data.tags.slice(0, 3).map(t => <span class="mpp-tag">{t}</span>)}
                  </div>
                )}
                <h3 class="mpp-title">{post.data.title}</h3>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </div>

  <div class="mhh-below">
    <section>
      <h2 class="page-title">Recent</h2>
      {posts.length > 0 ? (
        <div class="blog-grid">
          {posts.map(post => (
            <div class="mhh-card-wrap">
              <PostCard post={post} />
            </div>
          ))}
        </div>
      ) : (
        <p style="color:var(--text-muted);font-size:13px;">아직 작성된 글이 없습니다.</p>
      )}
      <a
        href="/blog"
        style="display:inline-block;margin-top:32px;font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--text-secondary);text-decoration:none;"
      >
        All Posts →
      </a>
    </section>
  </div>
<script is:inline>
(function () {
  if (window.innerWidth > 1024) return;
  if (!document.body.classList.contains('is-home')) return;

  /* ── 페이지 스크롤 잠금 ── */
  document.documentElement.style.overflow = 'hidden';
  document.body.style.overflow = 'hidden';

  /* ── 카드 슬롯 상수 ── */
  var PEEK_TOP  = 25;   /* px: 이전 카드가 위쪽으로 노출되는 양 */
  var CARD_H    = 220;  /* px: 카드 높이 (CSS height와 동기) */
  var FULL_STEP = 220;  /* px: 슬롯 간격 (CARD_H와 동일 → 카드 맞닿음) */

  function slotY(dist)   { return PEEK_TOP + dist * FULL_STEP; }
  function slotScale(dist) { return dist === 0 ? 1 : 0.87; }
  function slotOpacity(dist) {
    if (dist === 0) return 1;
    if (Math.abs(dist) === 1) return 0.62;
    return 0;
  }

  /* ── DOM ── */
  var heroCards = document.querySelectorAll('.mhh-post-preview');
  var dots      = document.querySelectorAll('.mhh-dot');
  var curIdx    = 0;

  function applySlot(card, dist, noTransition) {
    if (noTransition) card.style.transition = 'none';
    card.style.transform    = 'translateY(' + slotY(dist) + 'px) scaleX(' + slotScale(dist) + ')';
    card.style.opacity      = slotOpacity(dist);
    card.style.pointerEvents = dist === 0 ? 'auto' : 'none';
    card.classList.remove('peek-prev', 'peek-next');
    if (dist === 0) {
      card.classList.add('active');
      card.removeAttribute('aria-hidden');
      card.removeAttribute('tabindex');
    } else {
      card.classList.remove('active');
      card.setAttribute('aria-hidden', 'true');
      card.setAttribute('tabindex', '-1');
      if (dist === -1) card.classList.add('peek-prev');
      if (dist === 1)  card.classList.add('peek-next');
    }
  }

  function updateAll(idx, noTransition) {
    heroCards.forEach(function (c, i) { applySlot(c, i - idx, noTransition); });
    dots.forEach(function (d, i) { d.classList.toggle('active', i === idx); });
  }

  function goToCard(newIdx) {
    if (newIdx < 0 || newIdx >= heroCards.length || newIdx === curIdx) return;
    curIdx = newIdx;
    updateAll(curIdx, false);
  }

  /* 초기 배치 — 트랜지션 없이 */
  updateAll(0, true);
  requestAnimationFrame(function () {
    requestAnimationFrame(function () {
      heroCards.forEach(function (c) { c.style.transition = ''; });
    });
  });

  /* ── 스와이프 (드래그 추적 포함) ── */
  var touchStartY = 0;
  var isSwiping   = false;
  var heroEl = document.querySelector('.mobile-home-hero');

  if (heroEl && heroCards.length > 1) {
    heroEl.addEventListener('touchstart', function (e) {
      touchStartY = e.touches[0].clientY;
      isSwiping   = true;
      /* 드래그 중 트랜지션 제거 → 손가락 추적 */
      heroCards.forEach(function (c) { c.style.transition = 'none'; });
    }, { passive: true });

    heroEl.addEventListener('touchmove', function (e) {
      if (!isSwiping) return;
      e.preventDefault();
      var rawY = e.touches[0].clientY - touchStartY;
      /* 경계 하드캡: 첫/마지막 카드에서 빈 공간이 생기는 방향은 최대 12px로 제한 */
      var dragY = rawY;
      if (curIdx === 0 && rawY > 0)
        dragY = Math.min(rawY * 0.2, 12);
      if (curIdx === heroCards.length - 1 && rawY < 0)
        dragY = Math.max(rawY * 0.2, -12);
      heroCards.forEach(function (c, i) {
        var dist = i - curIdx;
        c.style.transform = 'translateY(' + (slotY(dist) + dragY) + 'px) scaleX(' + slotScale(dist) + ')';
      });
    }, { passive: false });

    heroEl.addEventListener('touchend', function (e) {
      if (!isSwiping) return;
      isSwiping = false;
      var dy = touchStartY - e.changedTouches[0].clientY;
      /* 트랜지션 복원 후 스냅 */
      heroCards.forEach(function (c) { c.style.transition = ''; });
      if (Math.abs(dy) > 48) {
        goToCard(dy > 0 ? curIdx + 1 : curIdx - 1);
      } else {
        updateAll(curIdx, false); /* 제자리 스냅백 */
      }
    }, { passive: true });

    heroEl.addEventListener('touchcancel', function () {
      if (!isSwiping) return;
      isSwiping = false;
      heroCards.forEach(function (c) { c.style.transition = ''; });
      updateAll(curIdx, false);
    }, { passive: true });
  }

  /* ── 검색 바 확장 토글 ── */
  var bar    = document.getElementById('mhh-bar');
  var btn    = document.getElementById('mhh-search-btn');
  var expand = document.getElementById('mhh-search-expand');
  var input  = document.getElementById('mhh-search-input');
  if (!bar || !btn || !expand || !input) return;

  function openSearch() {
    bar.classList.add('search-open');
    btn.setAttribute('aria-expanded', 'true');
    expand.setAttribute('aria-hidden', 'false');
    input.setAttribute('tabindex', '0');
    setTimeout(function () { input.focus(); }, 380);
  }

  function closeSearch() {
    bar.classList.remove('search-open');
    btn.setAttribute('aria-expanded', 'false');
    expand.setAttribute('aria-hidden', 'true');
    input.setAttribute('tabindex', '-1');
    input.value = '';
    input.blur();
  }

  btn.addEventListener('click', function () {
    bar.classList.contains('search-open') ? closeSearch() : openSearch();
  });
  input.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeSearch();
  });
  document.addEventListener('click', function (e) {
    if (bar.classList.contains('search-open') && !bar.contains(e.target)) closeSearch();
  });
})();
</script>
</Layout>
