---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<Layout title="Kitsune Hideout">
  <section class="about-section">
    <h2 class="page-title">About Kitsune</h2>
    <div class="about-placeholder">
      <!-- 소개 내용을 이후에 작성합니다 -->
    </div>
  </section>

  <section>
    <h2 class="page-title">Recent</h2>
    {posts.length > 0 ? (
      <div class="blog-grid">
        {posts.map(post => <PostCard post={post} />)}
      </div>
    ) : (
      <p style="color:var(--text-muted);font-size:13px;">아직 작성된 글이 없습니다.</p>
    )}
    <a
      href="/blog"
      style="display:inline-block;margin-top:32px;font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--text-secondary);text-decoration:none;"
    >
      All Posts →
    </a>
  </section>
</Layout>
