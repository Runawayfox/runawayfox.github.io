---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Search">
  <h1 class="page-title">Search</h1>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <div id="search"></div>
  <p
    id="search-notice"
    style="color:var(--text-muted);font-size:12px;margin-top:16px;display:none;"
  >
    검색 인덱스를 불러올 수 없습니다. 빌드 후 사용 가능합니다.
  </p>
</Layout>

<script is:inline>
  window.addEventListener('load', function () {
    import('/pagefind/pagefind-ui.js')
      .then(function (m) {
        new m.PagefindUI({
          element: '#search',
          showSubResults: true,
          translations: {
            placeholder: '검색어를 입력하세요...',
            zero_results: '"[SEARCH_TERM]"에 대한 결과가 없습니다.',
          },
        });
      })
      .catch(function () {
        var el = document.getElementById('search-notice');
        if (el) el.style.display = 'block';
      });
  });
</script>
