---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Search">
  <Fragment slot="head">
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  </Fragment>

  <h1 class="page-title">Search</h1>
  <div id="search"></div>
  <p
    id="search-notice"
    style="color:var(--text-muted);font-size:13px;margin-top:16px;display:none;"
  >
    검색 인덱스를 불러올 수 없습니다. 배포 후 사용 가능합니다.
  </p>
</Layout>

<script is:inline>
  (function () {
    function showNotice() {
      var el = document.getElementById('search-notice');
      if (el) el.style.display = 'block';
    }

    function initSearch() {
      /* pagefind-ui.js is a classic IIFE script, not an ES module.
         It sets window.PagefindUI — load it via <script> tag, not import(). */
      var script = document.createElement('script');
      script.src = '/pagefind/pagefind-ui.js';

      script.onload = function () {
        if (!window.PagefindUI) { showNotice(); return; }

        var ui = new window.PagefindUI({
          element: '#search',
          showSubResults: true,
          translations: {
            placeholder: '검색어를 입력하세요...',
            zero_results: '"[SEARCH_TERM]"에 대한 결과가 없습니다.',
          },
        });

        /* Auto-search from sidebar query param — wait one tick for UI to mount */
        var q = new URLSearchParams(window.location.search).get('q');
        if (q) setTimeout(function () { ui.triggerSearch(q); }, 50);
      };

      script.onerror = showNotice;
      document.head.appendChild(script);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSearch);
    } else {
      initSearch();
    }
  })();
</script>
