---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Search">
  <main class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white mb-8">Search</h1>
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <div id="search"></div>
    <p id="search-notice" class="text-sm text-slate-400 dark:text-slate-500 mt-4 hidden">
      검색 인덱스를 불러올 수 없습니다. 사이트를 빌드한 후 사용 가능합니다.
    </p>
  </main>
</Layout>

<script is:inline>
  window.addEventListener('load', function () {
    import('/pagefind/pagefind-ui.js')
      .then(function (module) {
        new module.PagefindUI({
          element: '#search',
          showSubResults: true,
          translations: {
            placeholder: '검색어를 입력하세요...',
            zero_results: '"[SEARCH_TERM]"에 대한 결과가 없습니다.',
          },
        });
      })
      .catch(function () {
        var notice = document.getElementById('search-notice');
        if (notice) notice.classList.remove('hidden');
      });
  });
</script>
