---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Search">
  <Fragment slot="head">
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  </Fragment>

  <h1 class="page-title">Search</h1>
  <div id="search"></div>
  <p
    id="search-notice"
    style="color:var(--text-muted);font-size:13px;margin-top:16px;display:none;"
  >
    검색 인덱스를 불러올 수 없습니다. 배포 후 사용 가능합니다.
  </p>
</Layout>

<script is:inline>
  (function () {
    function initSearch() {
      import('/pagefind/pagefind-ui.js')
        .then(function (m) {
          var ui = new m.PagefindUI({
            element: '#search',
            showSubResults: true,
            showEmptyFilters: false,
            translations: {
              placeholder: '검색어를 입력하세요...',
              zero_results: '"[SEARCH_TERM]"에 대한 결과가 없습니다.',
            },
          });

          /* URLSearchParams의 q를 읽어 자동 검색 — UI 렌더링 후 한 프레임 기다림 */
          var q = new URLSearchParams(window.location.search).get('q');
          if (q) {
            requestAnimationFrame(function () {
              setTimeout(function () { ui.triggerSearch(q); }, 0);
            });
          }
        })
        .catch(function () {
          var el = document.getElementById('search-notice');
          if (el) el.style.display = 'block';
        });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSearch);
    } else {
      initSearch();
    }
  })();
</script>
